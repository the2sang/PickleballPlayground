<% content_for :title, "기본 정보 등록" %>

<div class="cl-page">
  <div class="cl-content cl-content--narrow">
    <div style="margin-bottom:32px;">
      <h1 class="cl-hero__title">기본 정보 등록</h1>
      <p class="cl-hero__subtitle">운동 세션 참가 신청에 필요한 기본 정보를 입력해 주세요.</p>
    </div>

    <% if params[:redirect_after]&.start_with?("/clubs/") %>
      <div style="display:flex;align-items:flex-start;gap:12px;padding:14px 16px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;margin-bottom:24px;">
        <iconify-icon icon="lucide:circle-check" style="font-size:18px;color:#16a34a;flex-shrink:0;margin-top:1px;"></iconify-icon>
        <div>
          <p style="font-size:14px;font-weight:600;color:#15803d;margin-bottom:2px;">사이트 회원가입이 완료되었습니다!</p>
          <p style="font-size:13px;color:#166534;line-height:1.5;">
            클럽 회원가입을 신청하려면 아래 기본 정보를 먼저 입력해 주세요.<br>
            입력 완료 후 해당 클럽 페이지로 자동으로 이동합니다.
          </p>
        </div>
      </div>
    <% end %>

    <%= turbo_frame_tag "profile_modal_form" do %>
    <div class="cl-form-card">
      <%= form_with model: @user, url: profile_path, method: :patch, class: "cl-form", data: { turbo_frame: "_top" } do |f| %>
        <%= hidden_field_tag :redirect_after, params[:redirect_after] %>
        <% if @user.errors.any? %>
          <div class="cl-form__error">
            <% @user.errors.full_messages.each do |msg| %>
              <p><%= msg %></p>
            <% end %>
          </div>
        <% end %>

        <div class="cl-form__grid">
          <div class="cl-form__field">
            <label class="cl-form__label cl-form__label--required">이름</label>
            <%= f.text_field :display_name, class: "cl-form__input", placeholder: "실명을 입력해 주세요", required: true %>
          </div>
          <div class="cl-form__field">
            <label class="cl-form__label">닉네임</label>
            <%= f.text_field :nickname, class: "cl-form__input", value: @user.nickname, disabled: true %>
            <p style="margin-top:4px;font-size:11px;color:var(--hcp-cool-gray);">닉네임은 계정 설정에서 변경할 수 있습니다.</p>
          </div>
        </div>

        <div class="cl-form__field">
          <label class="cl-form__label cl-form__label--required">운동 레벨</label>
          <%= f.select :sport_level,
                [["초급", "beginner"], ["초중급", "beginner_intermediate"], ["중급", "intermediate"],
                 ["중상급", "intermediate_advanced"], ["상급", "advanced"]],
                { selected: @user.sport_level },
                class: "cl-form__select" %>
        </div>

        <div class="cl-form__grid">
          <div class="cl-form__field">
            <label class="cl-form__label cl-form__label--required">성별</label>
            <%= f.select :gender,
                  [["선택 안함", "unspecified"], ["남성", "male"], ["여성", "female"]],
                  { selected: @user.gender },
                  class: "cl-form__select" %>
          </div>
          <div class="cl-form__field">
            <label class="cl-form__label cl-form__label--required">연령대</label>
            <%= f.select :age_group,
                  [["10대", "teens"], ["20대", "twenties"], ["30대", "thirties"],
                   ["40대", "forties"], ["50대", "fifties"], ["60대 이상", "sixties_plus"]],
                  { selected: @user.age_group },
                  class: "cl-form__select" %>
          </div>
        </div>

        <div class="cl-form__field">
          <label class="cl-form__label">거주지역</label>
          <%= f.text_field :region, class: "cl-form__input", placeholder: "예) 용인시 기흥구" %>
        </div>

        <div class="cl-form__field" style="margin-top:8px;">
          <p style="font-size:12px;font-weight:600;color:var(--hcp-mid-gray);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:12px;">약관 동의 (필수)</p>

          <label style="display:flex;align-items:flex-start;gap:10px;padding:14px;border:1px solid var(--hcp-border-light);border-radius:8px;cursor:pointer;margin-bottom:8px;">
            <input type="checkbox" name="terms_agreed" value="1" required
                   style="margin-top:2px;flex-shrink:0;width:16px;height:16px;accent-color:var(--color-primary);">
            <span style="font-size:13px;line-height:1.5;color:var(--hcp-charcoal);">
              <strong>[필수]</strong> 이용약관에 동의합니다.
              <span style="display:block;margin-top:4px;font-size:11px;color:var(--hcp-cool-gray);">
                서비스 이용 시 회원 간 매너 있는 소통, 운동 세션 참가 규칙 준수 등 기본 이용 규칙에 동의합니다.
              </span>
            </span>
          </label>

          <label style="display:flex;align-items:flex-start;gap:10px;padding:14px;border:1px solid var(--hcp-border-light);border-radius:8px;cursor:pointer;">
            <input type="checkbox" name="privacy_agreed" value="1" required
                   style="margin-top:2px;flex-shrink:0;width:16px;height:16px;accent-color:var(--color-primary);">
            <span style="font-size:13px;line-height:1.5;color:var(--hcp-charcoal);">
              <strong>[필수]</strong> 개인정보 수집 및 이용에 동의합니다.
              <span style="display:block;margin-top:4px;font-size:11px;color:var(--hcp-cool-gray);">
                수집 항목: 이름, 성별, 연령대, 운동 레벨, 거주지역 / 목적: 운동 세션 참가 자격 확인 및 매칭 / 보유 기간: 회원 탈퇴 시까지
              </span>
            </span>
          </label>
        </div>

        <div class="cl-form__actions">
          <%= f.submit "저장하기", class: "cl-form__submit" %>
        </div>
      <% end %>
    </div>
    <% end %>
  </div>
</div>
