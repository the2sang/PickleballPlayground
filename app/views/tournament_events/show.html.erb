<% content_for :title, @event.discipline.humanize %>
<%
  discipline_labels = {
    "mens_singles" => "남자 단식", "mens_doubles" => "남자 복식",
    "womens_singles" => "여자 단식", "womens_doubles" => "여자 복식", "mixed_doubles" => "혼합 복식"
  }
  status_labels = { "setup" => "설정중", "qualifying" => "예선 진행중", "bracket" => "본선 진행중", "completed" => "완료" }
  is_manager = policy(@event).update?
%>

<div class="cl-page">
  <div class="cl-hero"><div class="cl-hero__inner">
    <p class="cl-hero__eyebrow"><%= link_to @event.tournament.name, tournament_path(@event.tournament) %> / 종목</p>
    <h1 class="cl-hero__title"><%= discipline_labels[@event.discipline] %></h1>
    <p class="cl-hero__subtitle"><%= status_labels[@event.status] %></p>
  </div></div>

  <div class="cl-content" style="max-width:900px;">
    <%# 추천 덱 카드 (Wave 4) %>
    <%= render "tournament_events/recommended_decks", is_manager: is_manager %>

    <%# 관리 버튼 %>
    <% if is_manager %>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px;">
        <%= link_to edit_tournament_event_path(@event), class: "btn btn--secondary btn--sm" do %>
          <iconify-icon icon="lucide:settings" width="13"></iconify-icon> 설정 수정
        <% end %>
        <% if @event.setup? && @teams.any? %>
          <div style="display:flex;align-items:center;gap:6px;">
            <%= form_with url: generate_groups_tournament_event_path(@event), method: :post, style: "display:flex;gap:6px;align-items:center;" do |f| %>
              <%= f.number_field :group_count, min: 1, value: 2, style: "width:60px;" , class: "cl-form__input" %>
              <%= f.submit "조 자동편성", class: "btn btn--primary btn--sm" %>
            <% end %>
          </div>
        <% end %>
        <% if @event.qualifying? %>
          <%= button_to generate_bracket_tournament_event_path(@event), method: :post,
                class: "btn btn--primary btn--sm",
                data: { turbo_confirm: "예선 결과로 본선 대진을 생성하시겠습니까?" } do %>
            <iconify-icon icon="lucide:git-branch" width="13"></iconify-icon> 본선 대진 생성
          <% end %>
        <% end %>
        <%= button_to tournament_event_path(@event), method: :delete,
              class: "btn btn--secondary btn--sm",
              form: { data: { turbo_confirm: "종목을 삭제하시겠습니까?" } } do %>
          <iconify-icon icon="lucide:trash-2" width="13"></iconify-icon> 삭제
        <% end %>
      </div>
    <% end %>

    <%# 참가팀 섹션 %>
    <div class="cl-info-card" style="margin-bottom:16px;">
      <div class="cl-info-card__header" style="display:flex;justify-content:space-between;align-items:center;">
        <p class="cl-info-card__header-label">참가팀 (<%= @teams.size %>팀)</p>
        <% if is_manager %>
          <%= link_to new_tournament_event_tournament_team_path(@event), class: "btn btn--primary btn--sm" do %>
            <iconify-icon icon="lucide:plus" width="13"></iconify-icon> 팀 추가
          <% end %>
        <% end %>
      </div>

      <% if @teams.empty? %>
        <p style="padding:16px;color:var(--hcp-cool-gray);font-size:13px;">등록된 팀이 없습니다.</p>
      <% else %>
        <% @teams.each do |team| %>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 16px;border-bottom:1px solid var(--hcp-border,#e5e7eb);">
            <div>
              <span style="font-weight:500;font-size:14px;"><%= team.name %></span>
              <% if team.users.any? %>
                <span style="font-size:12px;color:var(--hcp-cool-gray);margin-left:8px;"><%= team.users.map(&:display_name).join(", ") %></span>
              <% end %>
            </div>
            <%= link_to tournament_team_path(team), class: "btn btn--secondary btn--sm" do %>
              <iconify-icon icon="lucide:users" width="13"></iconify-icon> 멤버
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# 조 편성 섹션 (예선 이상) %>
    <% if @event.qualifying? || @event.bracket? || @event.completed? %>
      <div class="cl-info-card" style="margin-bottom:16px;">
        <div class="cl-info-card__header" style="display:flex;justify-content:space-between;align-items:center;">
          <p class="cl-info-card__header-label">조 편성 (<%= @groups.size %>조)</p>
        </div>
        <% @groups.each do |group| %>
          <div style="padding:10px 16px;border-bottom:1px solid var(--hcp-border,#e5e7eb);">
            <%= link_to tournament_group_path(group), style: "font-weight:500;font-size:14px;" do %><%= group.name %><% end %>
            <span style="font-size:12px;color:var(--hcp-cool-gray);margin-left:8px;">
              <%= group.teams.map(&:name).join(", ") %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# 본선 브라켓 (bracket / completed) %>
    <% if @event.bracket? || @event.completed? %>
      <%
        bracket_matches = @event.matches
                                .includes(:home_team, :away_team, :winner)
                                .order(:round, :match_number)
        rounds = bracket_matches.group_by(&:round)
        max_round = rounds.keys.max || 0
        round_labels = {}
        rounds.each_key do |r|
          round_labels[r] = if r == max_round
                              "결승"
                            elsif r == max_round - 1
                              "준결승"
                            else
                              "#{r}라운드"
                            end
        end
      %>
      <div class="cl-info-card">
        <div class="cl-info-card__header">
          <p class="cl-info-card__header-label">본선 대진표</p>
        </div>

        <% rounds.sort.each do |round_num, matches| %>
          <div style="padding:12px 16px;border-bottom:1px solid var(--hcp-border,#e5e7eb);">
            <p style="font-size:12px;font-weight:600;color:var(--hcp-cool-gray);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;">
              <%= round_labels[round_num] %>
            </p>
            <% matches.each do |m| %>
              <div style="display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px dashed var(--hcp-border,#e5e7eb);font-size:14px;">
                <div style="flex:1;">
                  <span style="font-weight:<%= m.winner_id == m.home_team_id && m.winner_id ? '700' : '400' %>;">
                    <%= m.home_team&.name || (m.status == "pending" ? "TBD" : "BYE") %>
                  </span>
                  <span style="color:var(--hcp-cool-gray);margin:0 8px;font-size:12px;">vs</span>
                  <span style="font-weight:<%= m.winner_id == m.away_team_id && m.winner_id ? '700' : '400' %>;">
                    <%= m.away_team&.name || (m.status == "pending" ? "TBD" : "BYE") %>
                  </span>
                  <% if m.winner %>
                    <span class="cl-badge cl-badge--success" style="margin-left:8px;font-size:11px;">
                      <%= m.winner.name %> 승
                    </span>
                  <% end %>
                </div>
                <div style="display:flex;gap:6px;align-items:center;">
                  <% case m.status
                     when "completed", "locked" %>
                    <span class="cl-badge cl-badge--muted">완료</span>
                  <% when "in_progress" %>
                    <span class="cl-badge cl-badge--warning">진행중</span>
                  <% else %>
                    <span class="cl-badge cl-badge--muted">대기</span>
                  <% end %>
                  <%= link_to match_path(m), class: "btn btn--secondary btn--sm" do %>
                    <iconify-icon icon="lucide:eye" width="12"></iconify-icon>
                  <% end %>
                  <% if is_manager && m.pending? && m.home_team && m.away_team %>
                    <%= link_to edit_match_path(m), class: "btn btn--primary btn--sm" do %>
                      <iconify-icon icon="lucide:pencil" width="12"></iconify-icon>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
