<%
  group = dashboard[:group]
  teams = dashboard[:teams]
  standings = dashboard[:standings]
%>

<section id="<%= dom_id(group) %>" style="padding:16px;border-top:1px solid var(--hcp-border,#e5e7eb);">
  <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap;margin-bottom:12px;">
    <div>
      <h2 style="font-size:16px;font-weight:700;margin:0 0 4px;">
        <%= link_to group.name, tournament_group_path(group), style: "color:inherit;text-decoration:none;" %>
      </h2>
      <p style="font-size:12px;color:var(--hcp-cool-gray);margin:0;">
        <%= teams.map { |team| tournament_team_label(team) }.join(", ") %>
      </p>
    </div>

    <% if selectable %>
      <span class="cl-badge cl-badge--muted">예선 통과팀 선택</span>
    <% end %>
  </div>

  <div style="overflow-x:auto;margin-bottom:14px;">
    <table style="width:100%;min-width:646px;border-collapse:collapse;font-size:13px;">
      <thead>
        <tr style="background:var(--hcp-bg-subtle,#f9fafb);border-bottom:2px solid var(--hcp-border,#e5e7eb);">
          <th style="position:sticky;left:0;background:var(--hcp-bg-subtle,#f9fafb);z-index:1;padding:10px 12px;text-align:left;min-width:142px;">팀</th>
          <% teams.each do |team| %>
            <% member_names = tournament_team_member_names(team) %>
            <th style="padding:10px 12px;text-align:center;min-width:133px;white-space:normal;word-break:keep-all;">
              <span style="display:block;font-weight:700;"><%= team.name %></span>
              <% if member_names.present? %>
                <span style="display:block;font-size:11px;color:var(--hcp-cool-gray);margin-top:2px;">(<%= member_names %>)</span>
              <% end %>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% teams.each do |row_team| %>
          <tr style="border-bottom:1px solid var(--hcp-border,#e5e7eb);">
            <th style="position:sticky;left:0;background:white;z-index:1;padding:10px 12px;text-align:left;font-weight:600;min-width:142px;white-space:normal;word-break:keep-all;">
              <% member_names = tournament_team_member_names(row_team) %>
              <span style="display:block;"><%= row_team.name %></span>
              <% if member_names.present? %>
                <span style="display:block;font-size:11px;color:var(--hcp-cool-gray);margin-top:2px;">(<%= member_names %>)</span>
              <% end %>
            </th>
            <% teams.each do |column_team| %>
              <td style="padding:8px 10px;text-align:center;vertical-align:top;border-left:1px solid var(--hcp-border,#e5e7eb);">
                <% if row_team.id == column_team.id %>
                  <span style="color:var(--hcp-cool-gray);">-</span>
                <% else %>
                  <% match = dashboard[:matches_by_pair][[ row_team.id, column_team.id ].sort] %>
                  <% if match.present? %>
                    <div style="display:flex;flex-direction:column;gap:5px;align-items:center;">
                      <% if match.completed? && match.match_sets.any? %>
                        <%
                          score_parts = match.match_sets.sort_by(&:set_number).map do |set|
                            if match.home_team_id == row_team.id
                              "#{set.home_score}:#{set.away_score}"
                            else
                              "#{set.away_score}:#{set.home_score}"
                            end
                          end
                        %>
                        <span style="font-weight:700;color:<%= match.winner_id == row_team.id ? '#16a34a' : '#374151' %>;">
                          <%= score_parts.join(" / ") %>
                        </span>
                        <span class="cl-badge <%= match.winner_id == row_team.id ? 'cl-badge--success' : 'cl-badge--muted' %>">
                          <%= match.winner_id == row_team.id ? "승" : "패" %>
                        </span>
                      <% else %>
                        <span class="cl-badge cl-badge--muted">대기</span>
                      <% end %>

                      <% if is_manager && !match.locked? %>
                        <%= link_to (match.completed? ? "수정" : "입력"),
                              edit_match_path(match, return_to: tournament_event_path(event, anchor: dom_id(group))),
                              class: "btn btn--secondary btn--sm",
                              style: "padding:4px 8px;font-size:12px;" %>
                      <% else %>
                        <%= link_to "보기",
                              match_path(match),
                              class: "btn btn--secondary btn--sm",
                              style: "padding:4px 8px;font-size:12px;" %>
                      <% end %>
                    </div>
                  <% else %>
                    <span style="color:var(--hcp-cool-gray);">미편성</span>
                  <% end %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div style="overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:13px;">
      <thead>
        <tr style="background:var(--hcp-bg-subtle,#f9fafb);border-bottom:2px solid var(--hcp-border,#e5e7eb);">
          <% if selectable %>
            <th style="padding:8px 10px;text-align:center;width:56px;">통과</th>
          <% end %>
          <th style="padding:8px 10px;text-align:center;width:50px;">순위</th>
          <th style="padding:8px 10px;text-align:left;">팀</th>
          <th style="padding:8px 10px;text-align:center;">승</th>
          <th style="padding:8px 10px;text-align:center;">패</th>
          <th style="padding:8px 10px;text-align:center;">승률</th>
          <th style="padding:8px 10px;text-align:center;">득실차</th>
          <th style="padding:8px 10px;text-align:center;">점수</th>
        </tr>
      </thead>
      <tbody>
        <% standings.each do |row| %>
          <% checked_by_rank = row[:rank].present? && row[:rank] <= event.advances_per_group %>
          <tr style="border-bottom:1px solid var(--hcp-border,#e5e7eb);">
            <% if selectable %>
              <td style="padding:9px 10px;text-align:center;">
                <%= check_box_tag "advancing_team_ids[]", row[:team].id, checked_by_rank, aria: { label: "#{tournament_team_label(row[:team])} 예선 통과" } %>
              </td>
            <% end %>
            <td style="padding:9px 10px;text-align:center;font-weight:700;"><%= row[:rank] %></td>
            <td style="padding:9px 10px;font-weight:600;">
              <% member_names = tournament_team_member_names(row[:team]) %>
              <span style="display:block;"><%= row[:team].name %></span>
              <% if member_names.present? %>
                <span style="display:block;font-size:11px;color:var(--hcp-cool-gray);margin-top:2px;">(<%= member_names %>)</span>
              <% end %>
            </td>
            <td style="padding:9px 10px;text-align:center;color:#16a34a;font-weight:700;"><%= row[:wins] %></td>
            <td style="padding:9px 10px;text-align:center;color:#dc2626;"><%= row[:losses] %></td>
            <td style="padding:9px 10px;text-align:center;"><%= "%.0f%%" % (row[:win_pct] * 100) %></td>
            <td style="padding:9px 10px;text-align:center;">
              <span style="color:<%= row[:point_diff] >= 0 ? '#16a34a' : '#dc2626' %>;">
                <%= row[:point_diff] >= 0 ? "+#{row[:point_diff]}" : row[:point_diff] %>
              </span>
            </td>
            <td style="padding:9px 10px;text-align:center;"><%= row[:total_points] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
