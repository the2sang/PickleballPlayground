<% content_for :title, "#{@game_session.title} 랜덤 게임 매칭" %>

<div class="cl-page">
  <div class="cl-hero cl-hero--game-sessions-banner">
    <div class="cl-hero__inner">
      <p class="cl-hero__eyebrow">
        <%= link_to @game_session.club.name, club_path(@game_session.club) %>
        <span class="sep">/</span>
        <%= link_to "오픈 게임 세션",
              club_open_sessions_path(@game_session.club,
                open_session_id: @game_session.id,
                anchor: "open_session_#{@game_session.id}") %>
      </p>
      <h1 class="cl-hero__title">랜덤 게임 매칭</h1>
      <p class="cl-hero__subtitle">
        <%= @game_session.court_name.presence || @game_session.title %>
        · 확정 참가자 <%= @participants.size %>명
      </p>
    </div>
  </div>

  <div class="cl-content osm-page">
    <% unless @plan.success? %>
      <section class="cl-info-card osm-alert">
        <p><%= @plan.error %></p>
        <%= link_to "오픈 게임으로 돌아가기",
              club_open_sessions_path(@game_session.club,
                open_session_id: @game_session.id,
                anchor: "open_session_#{@game_session.id}"),
              class: "btn btn--secondary btn--sm" %>
      </section>
    <% else %>
      <section class="osm-toolbar">
        <div>
          <p class="osm-eyebrow"><%= @plan.automatic? ? "자동 매칭" : "수동 편성" %></p>
          <h2>총 <%= @plan.round_count %>라운드</h2>
        </div>
        <%= form_with url: game_session_open_session_matching_path(@game_session),
              method: :get,
              class: "osm-toolbar__form" do %>
          <%= hidden_field_tag :mode, @plan.mode %>
          <label>
            <span>라운드</span>
            <%= number_field_tag :rounds, @plan.round_count, min: 1,
                  max: OpenSessions::MatchPlanBuilder::MAX_ROUNDS %>
          </label>
          <label>
            <span>고정 선수 1</span>
            <%= select_tag :fixed_user_id,
                  options_for_select(
                    [ [ "선택 안 함", "" ] ] +
                      @participants.map { |participant| [ participant.display_name, participant.user_id ] },
                    params[:fixed_user_id]
                  ) %>
          </label>
          <label>
            <span>고정 선수 2</span>
            <%= select_tag :fixed_partner_user_id,
                  options_for_select(
                    [ [ "선택 안 함", "" ] ] +
                      @participants.map { |participant| [ participant.display_name, participant.user_id ] },
                    params[:fixed_partner_user_id]
                  ) %>
          </label>
          <label>
            <span>시작</span>
            <%= number_field_tag :fixed_partner_starts_round,
                  params[:fixed_partner_starts_round].presence || 1,
                  min: 1,
                  max: OpenSessions::MatchPlanBuilder::MAX_ROUNDS %>
          </label>
          <%= submit_tag "다시 생성", class: "btn btn--primary btn--sm" %>
        <% end %>
      </section>

      <% if @plan.fixed_pair.present? %>
        <p class="osm-fixed-note">
          <iconify-icon icon="lucide:pin" width="13"></iconify-icon>
          <%= @participants.find { |participant| participant.user_id == @plan.fixed_pair[:user_id] }&.display_name %>님과
          <%= @participants.find { |participant| participant.user_id == @plan.fixed_pair[:partner_user_id] }&.display_name %>님은
          <%= @plan.fixed_pair[:starts_round] %>라운드부터 같은 팀으로 우선 배치됩니다.
        </p>
      <% end %>

      <% if @plan.manual? %>
        <section class="osm-manual">
          <h2>수동 편성표</h2>
          <p>각 라운드와 게임별로 직접 선수를 선택해 현장에서 편성표를 완성할 수 있습니다.</p>
          <% @plan.rounds.each do |round| %>
            <article class="osm-round">
              <h3><%= round.number %>라운드</h3>
              <div class="osm-games">
                <% round.games.each do |game| %>
                  <div class="osm-game">
                    <h4><%= game.court_label %></h4>
                    <div class="osm-manual-grid">
                      <% %w[home_1 home_2 away_1 away_2].each_with_index do |slot, index| %>
                        <label>
                          <span><%= index < 2 ? "팀 A" : "팀 B" %> <%= index.even? ? "1" : "2" %></span>
                          <%= select_tag "manual[#{round.number}][#{game.court_label}][#{slot}]",
                                options_for_select([ [ "선택", "" ] ] + @plan.players.map { |player| [ player.name, player.id ] }),
                                class: "osm-select" %>
                        </label>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </article>
          <% end %>
        </section>
      <% else %>
        <section class="osm-rounds">
          <% @plan.rounds.each do |round| %>
            <article class="osm-round">
              <h3><%= round.number %>라운드</h3>
              <div class="osm-games">
                <% round.games.each do |game| %>
                  <div class="osm-game">
                    <h4><%= game.court_label %></h4>
                    <div class="osm-versus">
                      <div class="osm-team">
                        <span>팀 A</span>
                        <strong><%= game.home.players.map(&:name).join(" · ") %></strong>
                      </div>
                      <span class="osm-vs">VS</span>
                      <div class="osm-team">
                        <span>팀 B</span>
                        <strong><%= game.away.players.map(&:name).join(" · ") %></strong>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
              <% if round.waiting_players.any? %>
                <p class="osm-waiting">
                  대기: <%= round.waiting_players.map(&:name).join(", ") %>
                </p>
              <% end %>
            </article>
          <% end %>
        </section>
      <% end %>
    <% end %>
  </div>
</div>
