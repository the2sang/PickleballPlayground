<% content_for :title, "새 비밀번호 설정" %>

<div class="page page--narrow">
  <div class="auth-card">
    <div class="auth-card__header">
      <h1 class="page__title">새 비밀번호 설정</h1>
      <p style="font-size:13px;color:var(--color-text-muted);margin-top:6px;">안전한 새 비밀번호를 입력해 주세요.</p>
    </div>

    <%= form_with url: password_path(params[:token]), method: :put, class: "form" do |form| %>
      <div class="form__field">
        <%= form.label :password, "새 비밀번호", class: "form__label" %>
        <%= form.password_field :password, class: "form__input",
            placeholder: "최소 8자 이상",
            autocomplete: "new-password",
            maxlength: 72 %>
      </div>

      <div class="form__field">
        <%= form.label :password_confirmation, "비밀번호 확인", class: "form__label" %>
        <%= form.password_field :password_confirmation, class: "form__input",
            placeholder: "비밀번호를 다시 입력하세요",
            autocomplete: "new-password",
            maxlength: 72 %>
      </div>

      <div class="form__actions">
        <%= form.submit "비밀번호 변경", class: "btn btn--primary" %>
        <%= link_to "취소", new_session_path, class: "btn btn--ghost" %>
      </div>
    <% end %>
  </div>
</div>
