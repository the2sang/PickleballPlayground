<div class="study-page">
  <header class="study-page__bar">
    <%= link_to deck_path(@deck), class: "study-page__back", aria: { label: "덱으로 돌아가기" } do %>
      <iconify-icon icon="lucide:arrow-left" width="16"></iconify-icon>
      <span class="study-page__back-label"><%= @deck.title %></span>
    <% end %>

    <span class="study-page__mode-chip">
      <iconify-icon icon="lucide:brain-circuit" width="13"></iconify-icon>
      학습 모드
    </span>
  </header>

  <div class="study-page__body">
    <div id="study-card" class="study-page__card-wrap">
      <%= render "decks/studies/card", card: @current_card, deck: @deck,
          options: @options, completed_count: @completed_count, total_count: @total_count,
          study_session: @study_session, current_index: @current_index,
          previous_card_path: @previous_card_path, next_card_path: @next_card_path,
          card_difficulty: @card_difficulty, card_bookmarked: @card_bookmarked %>
    </div>
  </div>
</div>
