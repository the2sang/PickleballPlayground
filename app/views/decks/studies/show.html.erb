<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="mb-4 text-sm text-gray-500">
    <%= link_to @deck.title, deck_path(@deck), class: "hover:underline" %> &gt; 학습
  </div>

  <div class="mb-2 text-xs text-gray-400 text-right">남은 카드 <%= @due_cards.size %>장</div>

  <div id="study-card">
    <%= render "card", card: @due_cards.first, deck: @deck %>
  </div>
</div>
