<%
  total     = local_assigns.fetch(:total_count, 0)
  completed = local_assigns.fetch(:completed_count, 0)
  opts      = local_assigns.fetch(:options, [card.back])
  pct       = total > 0 ? (completed.to_f / total * 100).round : 0
  current_index = local_assigns.fetch(:current_index, completed)
  answered_rating = local_assigns[:answered_rating]
  selected_answer = local_assigns[:selected_answer].to_s
  answered = answered_rating.present?
  previous_card_path = local_assigns[:previous_card_path]
  next_card_path = local_assigns[:next_card_path]
  next_disabled = answered ? next_card_path.blank? : true
%>

<div data-controller="quiz-session"
     data-quiz-session-correct-value="<%= card.back %>"
     data-quiz-session-duration-value="60"
     data-quiz-session-answered-value="<%= answered %>"
     data-quiz-session-next-url-value="<%= next_card_path %>">

  <%# ── Progress ─────────────────────────────────────────── %>
  <div class="quiz-progress" aria-label="학습 진행률 <%= completed %>/<%= total %>">
    <span class="quiz-progress__num quiz-progress__num--done"><%= completed %></span>
    <div class="quiz-progress__track" role="progressbar"
         aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100">
      <div class="quiz-progress__fill" style="width: <%= pct %>%"></div>
    </div>
    <span class="quiz-progress__num quiz-progress__num--total"><%= total %></span>
  </div>

  <%# ── Card ──────────────────────────────────────────────── %>
  <div class="quiz-card">

    <%# Timer — top right %>
    <button type="button"
            class="quiz-timer"
            data-quiz-session-target="timer"
            data-action="click->quiz-session#pauseToggle"
            aria-label="타이머 일시정지/재생">
      <svg class="quiz-timer__svg" viewBox="0 0 40 40" aria-hidden="true">
        <circle class="quiz-timer__track" cx="20" cy="20" r="16"/>
        <circle class="quiz-timer__ring" cx="20" cy="20" r="16"
                data-quiz-session-target="timerRing"/>
      </svg>
      <span class="quiz-timer__num" data-quiz-session-target="timerDisplay">60</span>
      <iconify-icon class="quiz-timer__icon"
                    data-quiz-session-target="pauseIcon"
                    icon="lucide:pause" width="9" aria-hidden="true"></iconify-icon>
    </button>

    <%# Question area %>
    <div class="quiz-card__question">
      <div class="quiz-card__type">
        <span>단어</span>
        <iconify-icon icon="lucide:volume-2" width="12"></iconify-icon>
      </div>
      <p class="quiz-card__text"><%= card.front %></p>
    </div>

    <%# Divider + section label %>
    <div class="quiz-card__divider">
      <span class="quiz-card__divider-line"></span>
      <span class="quiz-card__section-label">정답을 고르세요</span>
      <span class="quiz-card__divider-line"></span>
    </div>

    <%# Options + form %>
    <%= form_with url: card_reviews_path, method: :post,
        data: { turbo: true, "quiz-session-target": "form" } do |f| %>
      <%= f.hidden_field "card_review[card_id]",          value: card.id %>
      <%= f.hidden_field "card_review[deck_id]",          value: deck.id %>
      <%= f.hidden_field "card_review[study_session_id]", value: local_assigns[:study_session]&.id %>
      <%= f.hidden_field "card_review[rating]", value: answered_rating || "",
          data: { "quiz-session-target": "rating" } %>
      <%= f.hidden_field "card_review[selected_answer]", value: selected_answer,
          data: { "quiz-session-target": "selectedAnswer" } %>

      <div class="quiz-options">
        <% opts.each_with_index do |option, idx| %>
          <%
            result = nil
            if answered
              result = if option == card.back
                         "correct"
              elsif option == selected_answer
                         "wrong"
              else
                         "inactive"
              end
            end
          %>
          <button type="button"
                  class="quiz-option"
                  data-quiz-session-target="option"
                  data-value="<%= option %>"
                  <%= %(data-result="#{result}").html_safe if result %>
                  data-action="click->quiz-session#selectOption"
                  <%= "disabled" if answered %>
                  aria-label="선택지 <%= idx + 1 %>: <%= option %>">
            <span class="quiz-option__key"><%= idx + 1 %></span>
            <span class="quiz-option__text"><%= option %></span>
          </button>
        <% end %>
      </div>

      <div class="quiz-card__footer">
        <div class="quiz-card__secondary-actions">
          <button type="button"
                  class="quiz-skip"
                  data-action="click->quiz-session#skipCard"
                  <%= "disabled" if answered %>>
            <iconify-icon icon="lucide:flag" width="13"></iconify-icon>
            모르겠어요?
          </button>
          <span class="quiz-card__position"><%= current_index + 1 %> / <%= total %></span>
        </div>

        <div class="quiz-nav">
          <% if previous_card_path.present? %>
            <%= link_to previous_card_path,
                class: "quiz-nav__button",
                data: { turbo_stream: true },
                aria: { label: "이전 문제" } do %>
              <iconify-icon icon="lucide:arrow-left" width="15"></iconify-icon>
              이전
            <% end %>
          <% else %>
            <span class="quiz-nav__button quiz-nav__button--disabled" aria-disabled="true">
              <iconify-icon icon="lucide:arrow-left" width="15"></iconify-icon>
              이전
            </span>
          <% end %>

          <button type="button"
                  class="quiz-nav__button quiz-nav__button--primary"
                  data-quiz-session-target="nextButton"
                  data-action="click->quiz-session#nextCard"
                  <%= "disabled" if next_disabled %>>
            다음
            <iconify-icon icon="lucide:arrow-right" width="15"></iconify-icon>
          </button>
        </div>
      </div>
    <% end %>

  </div>

  <%# Keyboard hint %>
  <p class="quiz-hint">키보드 <kbd>1</kbd>–<kbd>4</kbd> 로도 선택할 수 있어요</p>
</div>
