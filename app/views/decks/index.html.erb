<% content_for :title, "낱말카드" %>

<div class="cl-page">
  <% if authenticated? && @personal_decks.empty? %>
    <%# 빈 상태 hero — 0개 personal 덱 사용자에게 학습 시작 유도 (DECK-07) %>
    <div class="cl-hero">
      <div class="cl-hero__inner">
        <div class="cl-hero__row">
          <div>
            <p class="cl-hero__eyebrow">낱말카드</p>
            <h1 class="cl-hero__title">낱말카드로 학습을 시작해 보세요</h1>
            <p class="cl-hero__subtitle">직접 덱을 만들거나 텍스트를 붙여넣어 카드를 빠르게 추가하세요.</p>
          </div>
          <%= render "decks/upload_tools" %>
        </div>
        <div style="display:flex; gap:12px; margin-top:24px;">
          <%= link_to new_deck_path, class: "btn btn--primary" do %>
            <iconify-icon icon="lucide:plus" width="14"></iconify-icon>
            내 덱 만들기
          <% end %>
          <%= link_to new_deck_path, class: "btn btn--secondary" do %>
            <iconify-icon icon="lucide:clipboard-paste" width="14"></iconify-icon>
            붙여넣기 가져오기
          <% end %>
        </div>
      </div>
    </div>

    <%# 공식 덱 미리보기 %>
    <% if @official_decks.any? %>
    <div class="cl-content" style="margin-top:32px;">
      <h2 style="font-size:1.1rem; font-weight:600; margin-bottom:16px;">공식 덱</h2>
      <div class="cl-grid">
        <%= render partial: "deck", collection: @official_decks, as: :deck %>
      </div>
    </div>
    <% end %>

  <% elsif authenticated? %>
    <%# 3섹션 허브 — personal 덱 보유 사용자 %>
    <div class="cl-hero">
      <div class="cl-hero__inner">
        <div class="cl-hero__row">
          <div>
            <p class="cl-hero__eyebrow">낱말카드</p>
            <h1 class="cl-hero__title">낱말카드 허브</h1>
          </div>
          <div class="deck-hub-actions">
            <%= render "decks/upload_tools" %>
            <%= link_to new_deck_path, class: "btn btn--primary btn--sm" do %>
              <iconify-icon icon="lucide:plus" width="13"></iconify-icon>
              새 덱 만들기
            <% end %>
          </div>
        </div>

        <%# Stats row — streak / today / due remaining %>
        <div style="display:flex;gap:24px;margin-top:20px;flex-wrap:wrap;">
          <div style="display:flex;flex-direction:column;align-items:center;">
            <span style="font-size:1.5rem;font-weight:700;"><%= @streak > 0 ? "🔥 #{@streak}일" : "—" %></span>
            <span style="font-size:11px;color:var(--hcp-cool-gray);">연속 학습</span>
          </div>
          <div style="display:flex;flex-direction:column;align-items:center;">
            <span style="font-size:1.5rem;font-weight:700;"><%= @today_progress[:reviewed_today] %> / <%= @today_progress[:reviewed_today] + @today_progress[:due_remaining] %></span>
            <span style="font-size:11px;color:var(--hcp-cool-gray);">오늘 완료</span>
          </div>
          <% if @today_progress[:due_remaining] > 0 %>
          <div style="display:flex;flex-direction:column;align-items:center;">
            <span style="font-size:1.5rem;font-weight:700;"><%= @today_progress[:due_remaining] %></span>
            <span style="font-size:11px;color:var(--hcp-cool-gray);">남은 복습</span>
          </div>
          <% end %>
        </div>

        <%# 7일 막대 차트 %>
        <% if @due_forecast.any? && @due_forecast.map { |r| r[:count] }.max.to_i > 0 %>
          <% max_count = @due_forecast.map { |r| r[:count] }.max.to_f %>
          <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px;height:48px;margin-top:16px;align-items:flex-end;">
            <% @due_forecast.each do |row| %>
              <% pct = max_count > 0 ? (row[:count] / max_count * 100).round : 0 %>
              <div style="display:flex;flex-direction:column;align-items:center;height:100%;">
                <div style="width:100%;background:var(--hcp-accent,#3b82f6);border-radius:2px;height:<%= pct %>%;min-height:<%= row[:count] > 0 ? 4 : 0 %>px;"></div>
              </div>
            <% end %>
          </div>
          <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-top:4px;">
            <% @due_forecast.each do |row| %>
              <div style="text-align:center;font-size:10px;color:var(--hcp-cool-gray);">
                <%= row[:date] == Date.current ? "오늘" : I18n.l(row[:date], format: "%m/%d") %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="cl-content">
      <%# 공식 덱 섹션 %>
      <% if @official_decks.any? %>
      <section style="margin-bottom:40px;">
        <h2 style="font-size:1.1rem; font-weight:600; margin-bottom:16px;">공식 덱</h2>
        <div class="cl-grid">
          <%= render partial: "deck", collection: @official_decks, as: :deck %>
        </div>
      </section>
      <% end %>

      <%# 클럽 덱 섹션 (approved 멤버십 보유 시에만) %>
      <% if @show_club_section && @club_decks.any? %>
      <section style="margin-bottom:40px;">
        <h2 style="font-size:1.1rem; font-weight:600; margin-bottom:16px;">클럽 덱</h2>
        <div class="cl-grid">
          <%= render partial: "deck", collection: @club_decks, as: :deck %>
        </div>
      </section>
      <% end %>

      <%# 내 덱 섹션 %>
      <section>
        <h2 style="font-size:1.1rem; font-weight:600; margin-bottom:16px;">내 덱</h2>
        <div class="cl-grid">
          <%= render partial: "deck", collection: @personal_decks, as: :deck %>
        </div>
      </section>
    </div>

  <% else %>
    <%# 비인증 사용자 — 공식 덱만 표시 + 로그인 CTA %>
    <div class="cl-hero">
      <div class="cl-hero__inner">
        <div class="cl-hero__row">
          <div>
            <p class="cl-hero__eyebrow">낱말카드</p>
            <h1 class="cl-hero__title">피클볼 낱말카드</h1>
            <p class="cl-hero__subtitle">규칙·용어·전술을 카드로 학습하세요.</p>
          </div>
          <%= link_to new_session_path, class: "btn btn--primary btn--sm" do %>
            <iconify-icon icon="lucide:log-in" width="13"></iconify-icon>
            로그인하고 시작하기
          <% end %>
        </div>
      </div>
    </div>

    <% if @official_decks.any? %>
    <div class="cl-content">
      <h2 style="font-size:1.1rem; font-weight:600; margin-bottom:16px;">공식 덱</h2>
      <div class="cl-grid">
        <%= render partial: "deck", collection: @official_decks, as: :deck %>
      </div>
    </div>
    <% end %>
  <% end %>
</div>
