<% current_category_param = @selected_category || 0 %>
<% official_tab_active = @selected_deck_tab == "official" %>
<% personal_tab_active = @selected_deck_tab == "personal" %>

<div class="deck-hub-tabs" role="tablist" aria-label="낱말카드 덱">
  <%= link_to decks_path(deck_tab: "official", category: current_category_param),
        id: "deck-tab-official",
        class: "deck-hub-tabs__trigger#{official_tab_active ? " deck-hub-tabs__trigger--active" : ""}",
        role: "tab",
        aria: { selected: official_tab_active, controls: "deck-panel-official" } do %>
    <iconify-icon icon="lucide:badge-check" width="15" aria-hidden="true"></iconify-icon>
    <span>공식 덱</span>
    <span class="deck-hub-tabs__count"><%= @official_decks.size %></span>
  <% end %>

  <%= link_to decks_path(deck_tab: "personal", category: current_category_param),
        id: "deck-tab-personal",
        class: "deck-hub-tabs__trigger#{personal_tab_active ? " deck-hub-tabs__trigger--active" : ""}",
        role: "tab",
        aria: { selected: personal_tab_active, controls: "deck-panel-personal" } do %>
    <iconify-icon icon="lucide:folder-user" width="15" aria-hidden="true"></iconify-icon>
    <span>내 덱</span>
    <span class="deck-hub-tabs__count"><%= @personal_decks.size %></span>
  <% end %>
</div>
