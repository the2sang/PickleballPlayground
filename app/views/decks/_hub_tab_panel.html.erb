<% if @selected_deck_tab == "personal" %>
  <div id="deck-panel-personal" class="deck-hub-panel" role="tabpanel" aria-labelledby="deck-tab-personal">
    <% if @personal_decks.any? %>
      <%= render "decks/deck_collection", title: "내 덱", decks: @personal_decks %>
    <% elsif !authenticated? %>
      <div class="cl-empty">
        <div class="cl-empty__icon">
          <iconify-icon icon="lucide:log-in" width="20" aria-hidden="true"></iconify-icon>
        </div>
        <p class="cl-empty__text">내 덱은 로그인 후 사용할 수 있습니다.</p>
        <%= link_to new_session_path, class: "btn btn--primary btn--sm", style: "margin-top:12px;" do %>
          <iconify-icon icon="lucide:log-in" width="13" aria-hidden="true"></iconify-icon>
          로그인하고 시작하기
        <% end %>
      </div>
    <% else %>
      <div class="cl-empty">
        <div class="cl-empty__icon">
          <iconify-icon icon="lucide:folder-plus" width="20" aria-hidden="true"></iconify-icon>
        </div>
        <p class="cl-empty__text">아직 만든 내 덱이 없습니다.</p>
        <%= link_to new_deck_path, class: "btn btn--primary btn--sm", style: "margin-top:12px;" do %>
          <iconify-icon icon="lucide:plus" width="13" aria-hidden="true"></iconify-icon>
          내 덱 만들기
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div id="deck-panel-official" class="deck-hub-panel" role="tabpanel" aria-labelledby="deck-tab-official">
    <% if @official_decks.any? %>
      <%= render "decks/deck_collection", title: "공식 덱", decks: @official_decks %>
    <% else %>
      <div class="cl-empty">
        <p class="cl-empty__text">표시할 공식 덱이 없습니다.</p>
      </div>
    <% end %>

    <% if @show_club_section && @club_decks.any? %>
      <%= render "decks/deck_collection", title: "클럽 덱", decks: @club_decks %>
    <% end %>
  </div>
<% end %>
