<div class="study-page">
  <header class="study-page__bar">
    <%= link_to deck_path(@deck), class: "study-page__back", aria: { label: "덱으로 돌아가기" } do %>
      <iconify-icon icon="lucide:arrow-left" width="16" aria-hidden="true"></iconify-icon>
      <span class="study-page__back-label"><%= @deck.title %></span>
    <% end %>

    <span class="study-page__mode-chip">
      <iconify-icon icon="lucide:book-open" width="13" aria-hidden="true"></iconify-icon>
      훑어보기
    </span>
  </header>

  <div class="study-page__body">
    <div class="study-page__card-wrap">
      <% if @cards.any? %>
        <div data-controller="browse"
             data-browse-cards-value="<%= @cards_json.to_json %>"
             class="browse-session">
          <div class="browse-session__meta">
            <span class="browse-session__chip">진도 미기록</span>
            <span data-browse-target="counter"
                  aria-live="polite"
                  class="browse-session__counter">1 / 전체 <%= @cards.size %></span>
          </div>

          <%= render "card", deck: @deck %>

          <div class="browse-nav">
            <button type="button"
                    data-action="click->browse#prev"
                    data-browse-target="prevButton"
                    aria-label="이전 카드"
                    class="browse-nav__button">
              <iconify-icon icon="lucide:arrow-left" width="15" aria-hidden="true"></iconify-icon>
              이전
            </button>

            <button type="button"
                    data-action="click->browse#toggleShuffle"
                    data-browse-target="shuffleButton"
                    class="browse-shuffle">
              <iconify-icon icon="lucide:shuffle" width="14" aria-hidden="true"></iconify-icon>
              셔플
            </button>

            <button type="button"
                    data-action="click->browse#next"
                    data-browse-target="nextButton"
                    aria-label="다음 카드"
                    class="browse-nav__button browse-nav__button--primary">
              다음
              <iconify-icon icon="lucide:arrow-right" width="15" aria-hidden="true"></iconify-icon>
            </button>
          </div>
        </div>
      <% else %>
        <div class="browse-empty">
          <div class="browse-empty__icon">
            <iconify-icon icon="lucide:book-open" width="28" aria-hidden="true"></iconify-icon>
          </div>
          <p class="browse-empty__text">이 덱에 카드가 없습니다. 카드를 추가하면 여기에 표시됩니다.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
