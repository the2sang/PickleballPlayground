<% content_for :title, @deck.title %>

<% deck_policy = policy(@deck) %>
<% can_edit    = deck_policy.update? %>
<% can_fork    = deck_policy.fork? %>
<% can_feature = deck_policy.feature? %>

<div class="cl-page">
  <div class="cl-hero">
    <div class="cl-hero__inner">
      <div class="cl-hero__row">
        <div>
          <p class="cl-hero__eyebrow">
            <%= link_to "낱말카드", decks_path %>
            <span class="sep">/</span>
            <%= { "official" => "공식", "club" => "클럽", "personal" => "내 덱" }[@deck.scope] %>
            <% if @deck.featured_at? %>
              <span style="color:#f59e0b; font-size:0.8rem;">★ 피처드</span>
            <% end %>
          </p>
          <h1 class="cl-hero__title"><%= @deck.title %></h1>
          <% if @deck.description.present? %>
            <p class="cl-hero__subtitle"><%= @deck.description %></p>
          <% end %>
          <p style="font-size:0.85rem; color:#6b7280; margin-top:8px;"><%= @deck.cards.size %>장의 카드</p>
        </div>

        <div style="display:flex; flex-direction:column; gap:8px; align-items:flex-end;">
          <div style="display:flex; gap:8px;">
            <% if @deck.cards.size.positive? %>
              <details class="study-dropdown">
                <summary class="btn btn--primary btn--sm">학습 시작</summary>
                <div class="study-dropdown__menu">
                  <%= link_to "전체 카드", deck_study_path(@deck), class: "study-dropdown__item" %>
                  <% if authenticated? && @bookmarked_count.to_i > 0 %>
                    <%= link_to "북마크한 문제만",
                          deck_study_path(@deck, card_filter: "bookmarked"),
                          class: "study-dropdown__item" %>
                  <% end %>
                  <% if authenticated? && @rated_count.to_i > 0 %>
                    <div class="study-dropdown__divider"></div>
                    <% (1..5).each do |n| %>
                      <%= link_to "난이도 #{n}점",
                            deck_study_path(@deck, difficulty: n),
                            class: "study-dropdown__item" %>
                    <% end %>
                    <div class="study-dropdown__divider"></div>
                    <% (1..5).each do |n| %>
                      <%= link_to "#{"★" * n}#{"☆" * (5 - n)} 이상",
                            deck_study_path(@deck, min_stars: n),
                            class: "study-dropdown__item" %>
                    <% end %>
                  <% end %>
                </div>
              </details>

              <details class="study-dropdown">
                <summary class="btn btn--ghost btn--sm">주관식 학습</summary>
                <div class="study-dropdown__menu">
                  <%= link_to "전체 카드", deck_flip_path(@deck), class: "study-dropdown__item" %>
                  <%= link_to "별3개 이상만",
                        deck_flip_path(@deck, min_stars: 3),
                        class: "study-dropdown__item" %>
                  <% if authenticated? && @rated_count.to_i > 0 %>
                    <div class="study-dropdown__divider"></div>
                    <% ([1, 2, 4, 5]).each do |n| %>
                      <%= link_to "#{"★" * n}#{"☆" * (5 - n)} 이상",
                            deck_flip_path(@deck, min_stars: n),
                            class: "study-dropdown__item" %>
                    <% end %>
                  <% end %>
                </div>
              </details>

              <%= link_to "훑어보기", deck_browse_path(@deck), class: "btn btn--ghost btn--sm" %>
            <% else %>
              <button type="button" class="btn btn--primary btn--sm" disabled aria-disabled="true" title="카드를 먼저 추가하세요">학습 시작</button>
              <span style="font-size:0.85rem; color:#6b7280; align-self:center;">카드를 먼저 추가하세요</span>
            <% end %>
            <% if authenticated? %>
              <div data-controller="modal">
                <button type="button"
                        class="btn btn--ghost btn--sm"
                        data-action="click->modal#open">
                  학습이력
                </button>
                <%= render "decks/study_history_modal", deck: @deck, study_history: @study_history %>
              </div>
            <% end %>
            <% if can_fork %>
              <%= button_to "내 덱으로 복제", deck_fork_path(@deck), method: :post,
                    class: "btn btn--ghost btn--sm",
                    form: { data: { turbo_confirm: "이 덱을 내 학습 덱으로 복제하시겠습니까?" } } %>
            <% end %>
          </div>
          <% if can_edit %>
            <div style="display:flex; gap:8px;">
              <%= link_to "수정", edit_deck_path(@deck), class: "btn btn--ghost btn--sm" %>
              <%= button_to "삭제", @deck, method: :delete, class: "btn btn--danger btn--sm",
                    form: { data: { turbo_confirm: "정말 삭제하시겠습니까?" } } %>
            </div>
          <% end %>
          <% if can_feature %>
            <div style="display:flex; gap:8px;">
              <% if @deck.featured_at? %>
                <%= button_to "피처드 해제", deck_feature_path(@deck), method: :delete,
                      class: "btn btn--ghost btn--sm" %>
              <% else %>
                <%= button_to "피처드 설정", deck_feature_path(@deck), method: :post,
                      class: "btn btn--ghost btn--sm" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="cl-content">
    <div id="deck-cards-<%= @deck.id %>" class="deck-rows">
      <% if @cards.any? %>
        <%= render partial: "decks/card_row", collection: @cards, as: :card,
                   locals: { deck: @deck, can_edit: can_edit } %>
      <% else %>
        <p class="deck-rows__empty">아직 카드가 없습니다. 아래 폼에서 첫 카드를 추가하세요.</p>
      <% end %>
    </div>

    <% if can_edit %>
      <div class="deck-import-cta">
        <%= link_to "붙여넣기 가져오기",
              new_deck_cards_imports_path(@deck),
              class: "btn btn--ghost btn--sm" %>
      </div>
      <div id="deck-add-form-<%= @deck.id %>">
        <%= render "decks/card_add_form", deck: @deck, card: Card.new %>
      </div>
    <% end %>
  </div>
</div>
