<% content_for :title, @deck.title %>

<div class="cl-page">
  <div class="cl-hero">
    <div class="cl-hero__inner">
      <div class="cl-hero__row">
        <div>
          <p class="cl-hero__eyebrow">
            <%= link_to "낱말카드", decks_path %>
            <span class="sep">/</span>
            <%= { "official" => "공식", "club" => "클럽", "personal" => "내 덱" }[@deck.scope] %>
          </p>
          <h1 class="cl-hero__title"><%= @deck.title %></h1>
          <% if @deck.description.present? %>
            <p class="cl-hero__subtitle"><%= @deck.description %></p>
          <% end %>
          <p style="font-size:0.85rem; color:#6b7280; margin-top:8px;"><%= @deck.cards.size %>장의 카드</p>
        </div>

        <% if @deck.personal? && Current.user == @deck.owner %>
          <div style="display:flex; gap:8px;">
            <%= link_to "수정", edit_deck_path(@deck), class: "btn btn--ghost btn--sm" %>
            <%= button_to "삭제", @deck, method: :delete, class: "btn btn--danger btn--sm",
                  form: { data: { turbo_confirm: "정말 삭제하시겠습니까?" } } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="deck-actions" style="display:flex; gap:8px; margin:16px 0;">
    <% if @deck.cards.size.positive? %>
      <%= link_to "학습 시작", deck_study_path(@deck), class: "btn btn--primary btn--sm" %>
      <%= link_to "훑어보기", deck_browse_path(@deck), class: "btn btn--ghost btn--sm" %>
    <% else %>
      <button type="button" class="btn btn--primary btn--sm" disabled aria-disabled="true" title="카드를 먼저 추가하세요">학습 시작</button>
      <span class="deck-actions__hint" style="font-size:0.85rem; color:#6b7280; align-self:center;">카드를 먼저 추가하세요</span>
    <% end %>
  </div>

  <div id="deck-cards-<%= @deck.id %>" class="deck-cards">
    <% if @cards.any? %>
      <table class="deck-cards__table">
        <thead>
          <tr>
            <th>앞면</th>
            <th>뒷면</th>
            <th>힌트</th>
            <th>태그</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "decks/card_row", collection: @cards, as: :card, locals: { deck: @deck } %>
        </tbody>
      </table>
    <% else %>
      <p class="deck-cards__empty">아직 카드가 없습니다. 아래 폼에서 첫 카드를 추가하세요.</p>
    <% end %>
  </div>

  <% if @deck.personal? && Current.user == @deck.owner %>
    <div class="deck-import-cta">
      <%= link_to "붙여넣기 가져오기",
            new_deck_cards_imports_path(@deck),
            class: "btn btn--ghost btn--sm" %>
    </div>
    <div id="deck-add-form-<%= @deck.id %>">
      <%= render "decks/card_add_form", deck: @deck, card: Card.new %>
    </div>
  <% end %>
</div>
