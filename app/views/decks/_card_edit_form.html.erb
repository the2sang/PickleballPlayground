<div class="deck-row__edit-form"
     data-controller="card-form"
     data-card-form-card-type-value="<%= card.card_type %>"
     data-action="keydown->card-form#handleKeydown">

  <div class="card-edit-form__header">
    <div class="card-type-tabs" role="tablist" aria-label="카드 유형">
      <button class="card-type-tab"
              data-card-form-target="typeTab"
              data-type="basic"
              data-action="click->card-form#selectType"
              role="tab" aria-selected="true" type="button">주관식</button>
      <button class="card-type-tab"
              data-card-form-target="typeTab"
              data-type="multiple_choice"
              data-action="click->card-form#selectType"
              role="tab" aria-selected="false" type="button">객관식</button>
    </div>
  </div>

  <%= form_with model: [deck, card] do |f| %>
    <% if card.errors.any? %>
      <div class="cl-form__error">
        <% card.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
      </div>
    <% end %>

    <div class="cl-form">
      <%# 앞면 / 문제 (공통) %>
      <div class="cl-form__field cl-form__field--inline cl-form__field--top">
        <%= f.label :front, "앞면/문제", class: "cl-form__label" %>
        <%= f.text_area :front,
            class: "cl-form__textarea cl-form__textarea--front",
            placeholder: "앞면 / 문제",
            rows: 3,
            data: { card_form_target: "front" },
            autofocus: true %>
      </div>

      <%# 주관식 섹션 %>
      <div data-card-form-target="basicSection">
        <div class="cl-form">
          <div class="cl-form__field cl-form__field--inline">
            <%= f.label :back, "뒷면/정답", class: "cl-form__label" %>
            <%= f.text_field :back, class: "cl-form__input", placeholder: "뒷면 / 정답" %>
          </div>
          <div class="cl-form__field cl-form__field--inline">
            <%= f.label :hint, "힌트(선택)", class: "cl-form__label" %>
            <%= f.text_field :hint, class: "cl-form__input", placeholder: "힌트 (선택)" %>
          </div>
        </div>
      </div>

      <%# 객관식 섹션 %>
      <div data-card-form-target="multipleSection" hidden>
        <div class="cl-form">
          <div class="card-choices">
            <div class="card-choice">
              <span class="card-choice__badge card-choice__badge--correct">정답</span>
              <%= f.text_field :back, class: "cl-form__input", placeholder: "정답 입력...",
                  disabled: true,
                  data: { card_form_target: "backMultiple" } %>
            </div>
            <div class="card-choice">
              <span class="card-choice__badge">오답 1</span>
              <input type="text" placeholder="오답 1 입력..." class="cl-form__input" aria-label="오답 1">
            </div>
            <div class="card-choice">
              <span class="card-choice__badge">오답 2</span>
              <input type="text" placeholder="오답 2 입력..." class="cl-form__input" aria-label="오답 2">
            </div>
            <div class="card-choice">
              <span class="card-choice__badge">오답 3</span>
              <input type="text" placeholder="오답 3 입력..." class="cl-form__input" aria-label="오답 3">
            </div>
          </div>
          <p class="card-choices__note">오답 선택지 저장은 다음 업데이트에서 지원됩니다</p>
        </div>
      </div>

      <%# 태그 (공통) %>
      <div class="cl-form__field cl-form__field--inline">
        <%= f.label :tags, "태그(쉼표 구분)", class: "cl-form__label" %>
        <%= f.text_field :tags, class: "cl-form__input", placeholder: "태그 (쉼표 구분)" %>
      </div>

      <div class="cl-form__actions">
        <%= f.submit "저장", class: "btn btn--primary btn--sm" %>
        <%= link_to "취소", deck_path(deck),
            data: { turbo_frame: "_top", card_form_target: "cancel" },
            class: "btn btn--ghost btn--sm" %>
        <%= button_to "삭제", deck_card_path(deck, card), method: :delete,
            class: "btn btn--danger btn--sm",
            form: { data: { turbo_confirm: "정말 삭제하시겠습니까?" } } %>
      </div>
    </div>
  <% end %>
</div>
