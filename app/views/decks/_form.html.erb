<%= form_with model: deck, class: "cl-form" do |f| %>
  <% if deck.errors.any? %>
    <div class="cl-form__error">
      <% deck.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="cl-form__field">
    <%= f.label :title, "제목", class: "cl-form__label" %>
    <%= f.text_field :title, class: "cl-form__input", placeholder: "덱 이름을 입력하세요" %>
  </div>

  <div class="cl-form__field">
    <%= f.label :description, "설명", class: "cl-form__label" %>
    <%= f.text_area :description, class: "cl-form__input", rows: 3, placeholder: "덱에 대한 간단한 설명 (선택)" %>
  </div>

  <%= f.submit deck.persisted? ? "수정" : "만들기", class: "cl-form__submit" %>
<% end %>
