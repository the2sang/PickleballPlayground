<%= form_with model: [tournament.club, tournament], class: "cl-form" do |f| %>
  <% if tournament.errors.any? %>
    <div class="cl-form__error">
      <% tournament.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>

  <div class="cl-form__field">
    <%= f.label :name, "대회명", class: "cl-form__label" %>
    <%= f.text_field :name, class: "cl-form__input", placeholder: "예: 2025 봄 클럽 대회" %>
  </div>

  <div class="cl-form__field">
    <%= f.label :description, "설명 (선택)", class: "cl-form__label" %>
    <%= f.text_area :description, rows: 3, class: "cl-form__input" %>
  </div>

  <div class="cl-form__grid">
    <div class="cl-form__field">
      <%= f.label :starts_on, "시작일", class: "cl-form__label" %>
      <%= f.date_field :starts_on, class: "cl-form__input" %>
    </div>
    <div class="cl-form__field">
      <%= f.label :ends_on, "종료일", class: "cl-form__label" %>
      <%= f.date_field :ends_on, class: "cl-form__input" %>
    </div>
  </div>

  <%= f.submit tournament.persisted? ? "수정" : "등록", class: "cl-form__submit" %>
<% end %>
