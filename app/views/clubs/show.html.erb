<% content_for :title, @club.name %>

<div class="cl-page">
  <div class="cl-hero cl-hero--club-banner">
    <div class="cl-hero__inner">
      <p class="cl-hero__eyebrow">
        <%= link_to "클럽", clubs_path %>
        <span class="sep">/</span>
      </p>
      <div class="cl-hero__row">
        <div>
          <h1 class="cl-hero__title"><%= @club.name %></h1>
          <p class="cl-hero__subtitle"><%= @club.description %></p>
          <div style="margin-top:10px; display:flex; align-items:center; gap:6px;">
            <iconify-icon icon="lucide:users" width="13" style="color:var(--hcp-cool-gray)"></iconify-icon>
            <span style="font-size:12px; color:var(--hcp-mid-gray);">회원 <%= @club.club_memberships.approved.count %>명</span>
          </div>
          <turbo-frame id="club-join-<%= @club.id %>">
            <% membership = Current.user&.club_memberships&.find_by(club: @club) %>

            <% if membership&.approved? %>
              <%# 승인된 회원: 탈퇴 신청 버튼 %>
              <div style="margin-top:12px;">
                <div data-controller="modal">
                  <button type="button"
                          class="btn btn--ghost btn--sm"
                          style="color:var(--hcp-danger); border-color:var(--hcp-danger);"
                          data-action="click->modal#open">
                    <iconify-icon icon="lucide:log-out" width="13"></iconify-icon>
                    클럽탈퇴 신청
                  </button>

                  <dialog class="club-join-dialog"
                          data-modal-target="dialog"
                          data-action="click->modal#backdropClose">
                    <div class="club-join-dialog__inner">
                      <div class="club-join-dialog__header">
                        <iconify-icon icon="lucide:log-out" width="24" class="club-join-dialog__icon" style="color:var(--hcp-danger);"></iconify-icon>
                        <h2 class="club-join-dialog__title">클럽 탈퇴 신청</h2>
                      </div>
                      <div class="club-join-dialog__body">
                        <p class="club-join-dialog__lead">
                          <strong><%= @club.name %></strong>에서 탈퇴를 신청합니다.<br>
                          관리자 승인 후 탈퇴가 완료됩니다.
                        </p>
                        <%= form_with url: club_club_membership_path(@club, membership),
                                      method: :patch do |f| %>
                          <input type="hidden" name="status" value="withdrawal_requested">
                          <div style="margin-top:12px;">
                            <%= f.label :withdrawal_reason, "탈퇴 사유 (선택)", style: "display:block; font-size:13px; font-weight:600; margin-bottom:4px;" %>
                            <%= f.text_area :withdrawal_reason,
                                name: "withdrawal_reason",
                                rows: 3,
                                placeholder: "탈퇴 사유를 입력해 주세요 (선택사항)",
                                style: "width:100%; border:1px solid var(--hcp-border); border-radius:6px; padding:8px; font-size:13px; resize:none;" %>
                          </div>
                          <div class="club-join-dialog__footer">
                            <button type="button"
                                    class="btn btn--ghost btn--sm"
                                    data-action="click->modal#close">
                              취소
                            </button>
                            <%= f.submit "탈퇴 신청",
                                class: "btn btn--sm",
                                style: "background:var(--hcp-danger); color:#fff; border:none; cursor:pointer;" %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </dialog>
                </div>
              </div>

            <% elsif membership&.withdrawal_requested? %>
              <%# 탈퇴 신청 중: 뱃지 + 신청 취소 버튼 %>
              <div style="margin-top:12px; display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                <span class="admin-badge" style="background:#fee2e2; color:#b91c1c;">
                  <iconify-icon icon="lucide:clock" width="11" style="vertical-align:-1px;"></iconify-icon>
                  탈퇴 신청 중
                </span>
                <%= button_to club_club_membership_path(@club, membership),
                    method: :patch,
                    params: { status: "approved" },
                    class: "btn btn--ghost btn--sm",
                    style: "font-size:11px;" do %>
                  신청 취소
                <% end %>
              </div>

            <% elsif membership.nil? %>
              <%# 비회원: 기존 가입 버튼 %>
              <div style="margin-top:12px;">
                <% if Current.user %>
                  <div data-controller="modal">
                    <button type="button"
                            class="btn btn--primary btn--sm"
                            data-action="click->modal#open">
                      <iconify-icon icon="lucide:user-plus" width="13"></iconify-icon>
                      클럽 정회원 신청
                    </button>

                    <dialog class="club-join-dialog"
                            data-modal-target="dialog"
                            data-action="click->modal#backdropClose">
                      <div class="club-join-dialog__inner">
                        <div class="club-join-dialog__header">
                          <iconify-icon icon="lucide:shield-check" width="24" class="club-join-dialog__icon"></iconify-icon>
                          <h2 class="club-join-dialog__title">동호회 가입 안내</h2>
                        </div>
                        <div class="club-join-dialog__body">
                          <p class="club-join-dialog__lead">
                            <strong><%= @club.name %></strong>에 가입하기 전 아래 가이드를 확인해 주세요.
                          </p>
                          <ol class="club-join-dialog__guidelines">
                            <li>회원은 상호 존중과 배려의 자세로 활동합니다.</li>
                            <li>경기 중 공정한 플레이와 스포츠맨십을 지킵니다.</li>
                            <li>클럽 시설 및 장비를 소중히 사용하고 원상 복구합니다.</li>
                            <li>활동 일정 참석이 어려울 경우 사전에 알립니다.</li>
                            <li>클럽 내 개인 정보는 활동 목적 외에 사용하지 않습니다.</li>
                            <li>가입 후 관리자 승인 전 준회원으로 활동 가능합니다.</li>
                          </ol>
                        </div>
                        <div class="club-join-dialog__footer">
                          <button type="button"
                                  class="btn btn--ghost btn--sm"
                                  data-action="click->modal#close">
                            취소
                          </button>
                          <%= button_to club_club_memberships_path(@club),
                                method: :post,
                                class: "btn btn--primary btn--sm" do %>
                            <iconify-icon icon="lucide:check" width="13"></iconify-icon>
                            동의하고 가입하기
                          <% end %>
                        </div>
                      </div>
                    </dialog>
                  </div>
                <% else %>
                  <%# 비로그인: 회원가입 유도 %>
                  <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                    <%= link_to new_registration_path(return_to: club_path(@club)), class: "btn btn--primary btn--sm" do %>
                      <iconify-icon icon="lucide:user-plus" width="13"></iconify-icon>
                      클럽 정회원 신청
                    <% end %>
                  </div>
                  <span style="font-size:11px; color:var(--hcp-cool-gray); margin-left:8px;">
                    이미 계정이 있으신가요?
                    <%= link_to "로그인", new_session_path(return_to: club_path(@club)),
                          style: "color:var(--hcp-purple); text-decoration:underline;" %>
                  </span>
                <% end %>
              </div>
            <% end %>
          </turbo-frame>
        </div>
      </div>
    </div>
  </div>

  <div class="cl-content">
    <div class="cl-section-header">
      <p class="cl-section-label">운동 세션</p>
      <div style="display:flex; gap:8px;">
        <%= link_to club_open_sessions_path(@club), class: "btn btn--secondary btn--sm" do %>
          <iconify-icon icon="lucide:layout-grid" width="13"></iconify-icon> 오픈 게임
        <% end %>
        <% if policy(@club).manage? %>
          <%= link_to new_game_session_path(club_id: @club.id), class: "btn btn--primary btn--sm" do %>
            <iconify-icon icon="lucide:plus" width="13"></iconify-icon> 세션 추가
          <% end %>
        <% end %>
      </div>
    </div>

    <% if @game_sessions.empty? %>
      <div class="cl-empty">
        <div class="cl-empty__icon">
          <iconify-icon icon="lucide:calendar" width="18"></iconify-icon>
        </div>
        <p class="cl-empty__text">등록된 운동 세션이 없습니다.</p>
      </div>
    <% else %>
      <div class="cl-list">
        <% @game_sessions.each do |gs| %>
          <div class="cl-list-item" style="display:flex; align-items:center; justify-content:space-between;">
            <%= link_to game_session_path(gs), style:"flex:1; display:flex; align-items:center; gap:10px; text-decoration:none; color:inherit; min-width:0;" do %>
              <div class="cl-list-item__icon">
                <iconify-icon icon="lucide:dumbbell" width="14"></iconify-icon>
              </div>
              <div style="min-width:0;">
                <p class="cl-list-item__title">
                  <%= gs.title %>
                  <% if gs.scheduled_date.to_date == Date.today %>
                    <span style="display:inline-flex;align-items:center;justify-content:center;background:#a3e635;color:#1a1a1a;border-radius:999px;font-size:10px;font-weight:700;padding:1px 8px;margin-left:6px;line-height:1.6;">오늘</span>
                  <% end %>
                </p>
                <p class="cl-list-item__meta">
                  <%= format_session_date(gs.scheduled_date) %> &middot;
                  <%= gs.start_time.strftime("%H:%M") %>~<%= gs.end_time.strftime("%H:%M") %> &middot;
                  <%= gs.venue_name %>
                </p>
              </div>
            <% end %>
            <div class="cl-list-item__right" style="flex-shrink:0; display:flex; align-items:center; gap:8px;">
              <span class="cl-list-item__count"><%= gs.confirmed_count %><% if gs.max_participants %>/<%= gs.max_participants %><% end %>명</span>
              <% if gs.full? %>
                <span class="cl-badge cl-badge--neutral">마감</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="cl-content" style="margin-top:24px;">
    <div class="cl-section-header">
      <p class="cl-section-label">대회</p>
      <% if policy(Tournament.new(club: @club)).create? %>
        <%= link_to new_club_tournament_path(@club), class: "btn btn--primary btn--sm" do %>
          <iconify-icon icon="lucide:plus" width="13"></iconify-icon> 새 대회
        <% end %>
      <% end %>
    </div>

    <% if @tournaments.empty? %>
      <div class="cl-empty">
        <div class="cl-empty__icon">
          <iconify-icon icon="lucide:trophy" width="18"></iconify-icon>
        </div>
        <p class="cl-empty__text">등록된 대회가 없습니다.</p>
      </div>
    <% else %>
      <% status_labels = { "draft" => "준비중", "in_progress" => "진행중", "completed" => "완료" } %>
      <div class="cl-list">
        <% @tournaments.each do |t| %>
          <%= link_to tournament_path(t), class: "cl-list-item", style: "display:flex; align-items:center; justify-content:space-between; text-decoration:none; color:inherit;" do %>
            <div style="display:flex; align-items:center; gap:10px; min-width:0;">
              <div class="cl-list-item__icon">
                <iconify-icon icon="lucide:trophy" width="14"></iconify-icon>
              </div>
              <div style="min-width:0;">
                <p class="cl-list-item__title"><%= t.name %></p>
                <p class="cl-list-item__meta">
                  <%= t.starts_on&.strftime("%Y.%m.%d") %> ~ <%= t.ends_on&.strftime("%Y.%m.%d") %>
                  &middot; 종목 <%= t.tournament_events.size %>개
                </p>
              </div>
            </div>
            <div style="flex-shrink:0; display:flex; align-items:center; gap:8px;">
              <span class="cl-badge cl-badge--neutral"><%= status_labels[t.status] %></span>
              <iconify-icon icon="lucide:chevron-right" width="16" style="color:var(--hcp-cool-gray);"></iconify-icon>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
