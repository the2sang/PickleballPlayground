<%= form_with model: club, class: "cl-form" do |f| %>
  <% if club.errors.any? %>
    <div class="cl-form__error">
      <% club.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="cl-form__field">
    <%= f.label :name, "클럽 이름", class: "cl-form__label" %>
    <%= f.text_field :name, class: "cl-form__input" %>
  </div>

  <div class="cl-form__field">
    <%= f.label :description, "소개", class: "cl-form__label" %>
    <%= f.text_area :description, rows: 4, class: "cl-form__textarea" %>
  </div>

  <div class="cl-form__field">
    <%= f.label :contact_email, "관리자 이메일", class: "cl-form__label" %>
    <% if !club.persisted? && current_user %>
      <%= f.email_field :contact_email,
            class: "cl-form__input",
            readonly: true,
            style: "background:var(--hcp-surface,#f5f5f7); cursor:not-allowed; color:var(--hcp-cool-gray);" %>
      <p style="margin-top:4px; font-size:11px; color:var(--hcp-cool-gray);">
        <iconify-icon icon="lucide:lock" style="font-size:11px;vertical-align:middle;"></iconify-icon>
        가입한 이메일이 자동으로 설정됩니다. 클럽 저장 시 관리자 권한이 부여됩니다.
      </p>
    <% else %>
      <%= f.email_field :contact_email, class: "cl-form__input", placeholder: "admin@example.com" %>
      <p style="margin-top:4px; font-size:11px; color:var(--hcp-cool-gray);">이 이메일로 가입한 회원이 자동으로 관리자가 됩니다.</p>
    <% end %>
  </div>

  <% if club.persisted? %>
    <div class="cl-form__field">
      <%= f.label :contact_phone, "연락처", class: "cl-form__label" %>
      <%= f.telephone_field :contact_phone, class: "cl-form__input", placeholder: "010-0000-0000" %>
    </div>

    <div class="cl-form__field">
      <%= f.label :contact_kakao, "카카오 오픈채팅 링크 (선택)", class: "cl-form__label" %>
      <%= f.url_field :contact_kakao, class: "cl-form__input", placeholder: "https://open.kakao.com/o/..." %>
      <p style="margin-top:4px; font-size:11px; color:var(--hcp-cool-gray);">카카오 오픈채팅 링크를 입력하면 클럽 카드에 채팅 버튼이 표시됩니다.</p>
    </div>

    <div class="cl-form__field">
      <%= f.label :bank_account, "클럽 계좌 (선택)", class: "cl-form__label" %>
      <%= f.text_field :bank_account, class: "cl-form__input", placeholder: "예) 카카오뱅크 3333-00-0000000 홍길동" %>
      <p style="margin-top:4px; font-size:11px; color:var(--hcp-cool-gray);">참가 신청 페이지에 계좌 정보로 표시됩니다.</p>
    </div>
  <% end %>

  <%= f.submit "저장", class: "cl-form__submit" %>
<% end %>
