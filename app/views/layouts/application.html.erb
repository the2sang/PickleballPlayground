<!DOCTYPE html>
<html lang="ko">
  <head>
    <%= toast_css_variables %>

    <title>피클볼</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="format-detection" content="telephone=no,email=no,address=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="피클볼">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="turbo-cache-control" content="no-cache">

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Ultra&family=Press+Start+2P&family=Montserrat:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@2.1.0/dist/iconify-icon.min.js" defer></script>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
    <link rel="shortcut icon" href="/icon.svg">
    <link rel="apple-touch-icon" href="/icon-192.png">
    <link rel="manifest" href="/manifest">
    <meta name="theme-color" content="#7b42bc">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="피클볼">

    <%= stylesheet_link_tag "faw_toast.min", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "faw_toast.min", "data-turbo-track": "reload" %>
    <script>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/service-worker", { scope: "/" });
      }
      document.addEventListener("turbo:before-visit", function() {
        if (typeof Turbo !== "undefined") { Turbo.cache.clear(); }
      });
      window.addEventListener("pageshow", function(e) {
        if (e.persisted) { window.location.reload(); }
      });
    </script>
  </head>

  <body data-controller="pwa-install" data-turbo-cache="false">
    <%# iOS 홈 화면 추가 안내 모달 (전역) %>
    <div class="pwa-ios-modal" data-pwa-install-target="iosModal" hidden>
      <div class="pwa-ios-modal__backdrop" data-action="click->pwa-install#hideIosModal"></div>
      <div class="pwa-ios-modal__box">
        <button class="pwa-ios-modal__close" data-action="click->pwa-install#hideIosModal" aria-label="닫기">
          <iconify-icon icon="lucide:x"></iconify-icon>
        </button>
        <p class="pwa-ios-modal__title">
          <iconify-icon icon="lucide:smartphone"></iconify-icon> 홈 화면에 추가 (iOS)
        </p>
        <ol class="pwa-ios-modal__steps">
          <li>하단 <strong>공유 버튼</strong> <iconify-icon icon="lucide:share"></iconify-icon> 탭</li>
          <li><strong>홈 화면에 추가</strong> 선택</li>
          <li><strong>추가</strong> 버튼 탭</li>
        </ol>
        <p class="pwa-ios-modal__note">Safari 브라우저에서만 지원됩니다.</p>
      </div>
    </div>

    <nav class="nav">
      <div class="nav__inner">
        <div class="nav__left">
          <%= link_to root_path, class: "nav__logo" do %>
            <span class="nav__logo-text">PICKLEBALL</span>
          <% end %>
        </div>

        <div class="nav__menu">
          <%# 바로가기 — 비로그인 포함 모두에게 표시 (내 신청은 로그인 시만) %>
          <div class="nav__group"
               data-controller="nav-group"
               data-action="mouseenter->nav-group#hover mouseleave->nav-group#hoverOut">
            <button class="nav__group-btn"
                    data-action="click->nav-group#tap"
                    data-nav-group-target="trigger"
                    aria-expanded="false"
                    aria-haspopup="true">
              <span class="nav__group-label">바로가기</span>
              <iconify-icon icon="lucide:users" class="nav__group-icon"></iconify-icon>
              <iconify-icon icon="lucide:chevron-down" class="nav__group-chevron"></iconify-icon>
            </button>
            <div class="nav__dropdown" data-nav-group-target="dropdown">
              <%= link_to clubs_path, class: "nav__dropdown-item" do %>
                <iconify-icon icon="lucide:flag"></iconify-icon><span>클럽</span>
              <% end %>
              <%= link_to game_sessions_path, class: "nav__dropdown-item" do %>
                <iconify-icon icon="lucide:calendar-days"></iconify-icon><span>클럽 운동세션</span>
              <% end %>
              <%= link_to flash_meetups_path, class: "nav__dropdown-item" do %>
                <iconify-icon icon="lucide:zap"></iconify-icon><span>개인모집 운동세션</span>
              <% end %>
              <% if authenticated? %>
              <%= link_to my_participations_path, class: "nav__dropdown-item" do %>
                <iconify-icon icon="lucide:clipboard-list"></iconify-icon><span>내 신청</span>
              <% end %>
              <% end %>
            </div>
          </div>

          <%# 가입클럽 — 로그인 후 승인된 멤버십 클럽이 있을 때만 표시 %>
          <% if authenticated? && joined_clubs.any? %>
          <div class="nav__group"
               data-controller="nav-group"
               data-action="mouseenter->nav-group#hover mouseleave->nav-group#hoverOut">
            <button class="nav__group-btn"
                    data-action="click->nav-group#tap"
                    data-nav-group-target="trigger"
                    aria-expanded="false"
                    aria-haspopup="true">
              <span class="nav__group-label">가입클럽</span>
              <iconify-icon icon="lucide:heart-handshake" class="nav__group-icon"></iconify-icon>
              <iconify-icon icon="lucide:chevron-down" class="nav__group-chevron"></iconify-icon>
            </button>
            <div class="nav__dropdown" data-nav-group-target="dropdown">
              <% joined_clubs.each do |club| %>
                <%= link_to club_path(club), class: "nav__dropdown-item" do %>
                  <iconify-icon icon="lucide:flag"></iconify-icon><span><%= club.name %></span>
                <% end %>
              <% end %>
            </div>
          </div>
          <% end %>

          <%# 클럽관리 — 관리 중인 클럽이 있을 때만 표시 %>
          <% if managed_clubs.any? %>
          <div class="nav__group"
               data-controller="nav-group"
               data-action="mouseenter->nav-group#hover mouseleave->nav-group#hoverOut">
            <button class="nav__group-btn"
                    data-action="click->nav-group#tap"
                    data-nav-group-target="trigger"
                    aria-expanded="false"
                    aria-haspopup="true">
              <span class="nav__group-label">클럽관리</span>
              <iconify-icon icon="lucide:settings-2" class="nav__group-icon"></iconify-icon>
              <iconify-icon icon="lucide:chevron-down" class="nav__group-chevron"></iconify-icon>
            </button>
            <div class="nav__dropdown" data-nav-group-target="dropdown">
              <% managed_clubs.each do |club| %>
                <%= link_to manage_club_path(club), class: "nav__dropdown-item nav__dropdown-item--manage" do %>
                  <iconify-icon icon="lucide:settings-2"></iconify-icon><span><%= club.name %> 관리</span>
                <% end %>
              <% end %>
            </div>
          </div>
          <% end %>

          <%# Utils %>
          <% if authenticated? %>
          <div class="nav__group"
               data-controller="nav-group"
               data-action="mouseenter->nav-group#hover mouseleave->nav-group#hoverOut">
            <button class="nav__group-btn"
                    data-action="click->nav-group#tap"
                    data-nav-group-target="trigger"
                    aria-expanded="false"
                    aria-haspopup="true">
              <span class="nav__group-label">유틸리티</span>
              <iconify-icon icon="lucide:wrench" class="nav__group-icon"></iconify-icon>
              <iconify-icon icon="lucide:chevron-down" class="nav__group-chevron"></iconify-icon>
            </button>
            <div class="nav__dropdown" data-nav-group-target="dropdown">
              <%= link_to focus_path, class: "nav__dropdown-item" do %>
                <iconify-icon icon="lucide:timer"></iconify-icon><span>포모도로</span>
              <% end %>
              <%= link_to puzzle_path, class: "nav__dropdown-item" do %>
                <iconify-icon icon="lucide:puzzle"></iconify-icon><span>퍼즐조각맞추기</span>
              <% end %>
              <%= render "shared/nav_flashcard_badge" %>
            </div>
          </div>
          <% end %>
        </div>

        <div class="nav__right">
          <div class="nav__search-wrapper" data-controller="nav-search">
            <button class="nav__icon-btn"
                    aria-label="검색 열기"
                    data-nav-search-target="toggle"
                    data-action="click->nav-search#open">
              <iconify-icon icon="lucide:search"></iconify-icon>
            </button>
            <%= form_with url: clubs_path, method: :get, class: "nav-search",
                  data: { "nav-search-target": "form" } do |f| %>
              <iconify-icon icon="lucide:search" class="nav-search__icon"></iconify-icon>
              <%= f.text_field :q,
                  class: "nav-search__input",
                  placeholder: "클럽 검색...",
                  value: (params[:q] if request.path.start_with?("/clubs")),
                  autocomplete: "off",
                  data: { "nav-search-target": "input" } %>
              <span class="nav-search__hint"><kbd>⌘K</kbd></span>
            <% end %>
          </div>

          <% if current_user&.admin? %>
          <div class="nav__group"
               data-controller="nav-group"
               data-action="mouseenter->nav-group#hover mouseleave->nav-group#hoverOut">
            <button class="nav__group-btn"
                    data-action="click->nav-group#tap"
                    data-nav-group-target="trigger"
                    aria-expanded="false"
                    aria-haspopup="true">
              <iconify-icon icon="lucide:shield-half" class="nav__group-icon"></iconify-icon>
              <span class="nav__group-label">사이트관리자</span>
              <iconify-icon icon="lucide:chevron-down" class="nav__group-chevron"></iconify-icon>
            </button>
            <div class="nav__dropdown nav__dropdown--right" data-nav-group-target="dropdown">
              <%= link_to admin_root_path, class: "nav__dropdown-item" do %>
                <iconify-icon icon="lucide:shield-half"></iconify-icon><span>관리자 대시보드</span>
              <% end %>
              <%= link_to member_records_path, class: "nav__dropdown-item" do %>
                <iconify-icon icon="lucide:clipboard-list"></iconify-icon><span>회원명부관리</span>
              <% end %>
              <%= link_to admin_data_management_path, class: "nav__dropdown-item" do %>
                <iconify-icon icon="lucide:database"></iconify-icon><span>데이터관리</span>
              <% end %>
            </div>
          </div>
          <% end %>


          <div class="nav__divider"></div>

          <% if authenticated? %>
            <div class="nav__group"
                 data-controller="nav-group"
                 data-action="mouseenter->nav-group#hover mouseleave->nav-group#hoverOut">
              <button class="nav__group-btn"
                      data-action="click->nav-group#tap"
                      data-nav-group-target="trigger"
                      aria-expanded="false"
                      aria-haspopup="true">
                <iconify-icon icon="lucide:user-circle" class="nav__group-icon"></iconify-icon>
                <span class="nav__group-label nav-hide-mobile"><%= Current.session.user.nickname %></span>
                <iconify-icon icon="lucide:chevron-down" class="nav__group-chevron"></iconify-icon>
              </button>
              <div class="nav__dropdown nav__dropdown--right" data-nav-group-target="dropdown">
                <%= link_to edit_profile_path, class: "nav__dropdown-item" do %>
                  <iconify-icon icon="lucide:clipboard-list"></iconify-icon><span>참가 정보 수정</span>
                <% end %>
                <%= link_to edit_account_path, class: "nav__dropdown-item" do %>
                  <iconify-icon icon="lucide:settings"></iconify-icon><span>계정 설정</span>
                <% end %>
                <div class="nav__dropdown-divider"></div>
                <%= button_to session_path, method: :delete, class: "nav__dropdown-logout" do %>
                  <iconify-icon icon="lucide:log-out"></iconify-icon><span>Log out</span>
                <% end %>
              </div>
            </div>
          <% else %>
            <%= link_to new_session_path, class: "btn btn--secondary btn--sm" do %>
              <iconify-icon icon="lucide:log-in" class="nav-only-mobile"></iconify-icon>
              <span class="nav-hide-mobile">로그인</span>
            <% end %>
            <%= link_to new_registration_path, class: "btn btn--primary btn--sm" do %>
              <iconify-icon icon="lucide:user-plus" class="nav-only-mobile"></iconify-icon>
              <span class="nav-hide-mobile">회원가입</span>
            <% end %>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="site-content" data-controller="header-collapse">
      <% if content_for?(:title) %>
        <h1 class="sr-only"><%= content_for(:title) %></h1>
      <% end %>
      <%= yield %>
    </main>

    <footer class="footer">
      <div class="footer__inner">
        <span class="footer__copy">&copy; <%= Time.current.year %> 피클볼 클럽</span>
        <button class="footer__install-btn"
                data-pwa-install-target="footerBtn"
                data-action="click->pwa-install#install"
                aria-label="홈 화면에 추가">
          <iconify-icon icon="lucide:smartphone"></iconify-icon>
          <span>홈 화면에 추가</span>
        </button>
      </div>
    </footer>
    <%= toast_container %>
  </body>
</html>
