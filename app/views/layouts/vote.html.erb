<!DOCTYPE html>
<html lang="ko">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "2026년 국가 보안 표어/표스터 공모전 시행" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@2.1.0/dist/iconify-icon.min.js" defer></script>

    <%= stylesheet_link_tag "faw_toast.min", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "faw_toast.min", "data-turbo-track": "reload" %>
  </head>

  <body class="bg-slate-50 text-slate-800 antialiased font-sans">
    <main>
      <%= yield %>
    </main>
    <%= toast_container %>
  </body>
</html>
