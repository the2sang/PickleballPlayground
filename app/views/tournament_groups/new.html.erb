<% content_for :title, "조 추가" %>

<div class="cl-page">
  <div class="cl-hero"><div class="cl-hero__inner">
    <p class="cl-hero__eyebrow">
      <%= link_to @event.tournament.name, tournament_path(@event.tournament) %> /
      <%= link_to @event.discipline.humanize, tournament_event_path(@event) %>
    </p>
    <h1 class="cl-hero__title">조 추가</h1>
  </div></div>

  <div class="cl-content" style="max-width:480px;">
    <div class="cl-info-card">
      <%= form_with model: [@event, @group], class: "cl-form" do |f| %>
        <div class="cl-form__group">
          <%= f.label :name, "조 이름", class: "cl-form__label" %>
          <%= f.text_field :name, class: "cl-form__input", placeholder: "예: A조" %>
          <% @group.errors[:name].each do |msg| %>
            <p class="cl-form__error"><%= msg %></p>
          <% end %>
        </div>

        <div style="display:flex;gap:8px;margin-top:16px;">
          <%= f.submit "조 추가", class: "btn btn--primary" %>
          <%= link_to "취소", tournament_event_tournament_groups_path(@event), class: "btn btn--secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
