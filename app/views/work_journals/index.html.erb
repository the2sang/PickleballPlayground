<% content_for :title, "오늘하루" %>

<div class="cl-page today-journal-page">
  <div class="cl-content today-journal-content">
    <h1 class="sr-only">오늘하루</h1>

    <div class="today-journal-lookup-row">
      <%= form_with url: work_journals_path, method: :get, class: "oss-lookup-form" do |f| %>
        <span class="oss-lookup-form__label">작성 일지 검색 :</span>
        <%= f.date_field :date,
              value: @selected_date&.iso8601,
              class: "oss-lookup-form__date" %>
        <button type="submit" class="btn btn--secondary btn--sm">
          <iconify-icon icon="lucide:search" width="13"></iconify-icon> 조회
        </button>
        <% if @selected_date.present? %>
          <%= link_to work_journals_path, class: "btn btn--ghost btn--sm" do %>
            <iconify-icon icon="lucide:rotate-ccw" width="13"></iconify-icon> 전체 보기
          <% end %>
        <% end %>
      <% end %>
    </div>

    <div class="oss-admin-bar today-journal-actions">
      <%= link_to new_work_journal_path(date: Date.current.iso8601), class: "btn btn--primary btn--sm" do %>
        <iconify-icon icon="lucide:plus" width="13"></iconify-icon> 새 일지 만들기
      <% end %>
    </div>

    <% if @work_journals.empty? %>
      <div class="cl-info-card today-journal-empty">
        <iconify-icon icon="lucide:notebook-pen"></iconify-icon>
        <p><%= @selected_date.present? ? "선택한 날짜에 작성된 일지가 없습니다." : "아직 작성된 일지가 없습니다." %></p>
      </div>
    <% else %>
      <div class="oss today-journal-days" data-controller="accordion">
        <% @work_journals.group_by(&:work_date).each do |date, journals| %>
          <section class="oss-day today-journal-day">
            <h2 class="oss-day__title today-journal-day__title">
              <iconify-icon icon="lucide:calendar" width="15"></iconify-icon>
              <%= format_session_date(date, style: :long) %>
            </h2>

            <% journals.each do |work_journal| %>
              <% open = work_journal == @work_journals.first %>
              <article id="<%= dom_id(work_journal) %>" class="oss-card today-journal-entry-card">
                <button type="button"
                        class="oss-card__header today-journal-entry-card__trigger"
                        aria-expanded="<%= open %>"
                        data-action="click->accordion#toggle">
                  <span class="today-journal-entry-card__heading">
                    <span class="today-journal-entry-card__title-row">
                      <span class="today-journal-entry-card__title"><%= work_journal.title %></span>
                    </span>
                  </span>

                  <span class="today-journal-entry-card__meta">
                    <% if work_journal.work_date == Date.current %>
                      <span class="oss-card__today-badge">오늘</span>
                    <% end %>
                    <iconify-icon icon="lucide:chevron-down" class="oss-card__chevron"></iconify-icon>
                  </span>
                </button>

                <div class="oss-card__panel today-journal-entry-card__panel" <%= "hidden" unless open %>>
                  <div class="today-journal-entry-card__content prose">
                    <% if work_journal.content.present? %>
                      <%= render_markdown(work_journal.content) %>
                    <% else %>
                      <p>내용이 비어 있습니다.</p>
                    <% end %>
                  </div>

                  <div class="today-journal-entry-card__actions">
                    <%= link_to edit_work_journal_path(work_journal), class: "btn btn--ghost btn--sm" do %>
                      <iconify-icon icon="lucide:pen" width="13"></iconify-icon> 수정
                    <% end %>
                    <%= link_to work_journal_path(work_journal), class: "btn btn--ghost btn--sm" do %>
                      <iconify-icon icon="lucide:external-link" width="13"></iconify-icon> 상세
                    <% end %>
                  </div>
                </div>
              </article>
            <% end %>
          </section>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
