<%= form_with model: work_journal, class: "form today-journal-form" do |f| %>
  <% if work_journal.errors.any? %>
    <div class="form__errors">
      <p class="form__errors-title">입력 오류가 있습니다</p>
      <ul class="form__errors-list">
        <% work_journal.errors.each do |e| %>
          <li><%= e.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.hidden_field :work_date %>
  <%= f.hidden_field :content_format, value: work_journal.content_format || "markdown" %>
  <%= f.hidden_field :category, value: work_journal.category || "task" %>
  <%= f.hidden_field :status, value: work_journal.status || "in_progress" %>
  <%= f.hidden_field :progress, value: work_journal.progress || 0 %>
  <%= f.hidden_field :entry_type, value: work_journal.entry_type || "result" %>

  <div class="form__field">
    <%= f.label :title, "제목", class: "form__label" %>
    <%= f.text_field :title,
          class: "form__input",
          placeholder: "오늘 하루를 한 줄로 적어보세요",
          maxlength: 200,
          required: true,
          autofocus: true %>
  </div>

  <div class="form__field">
    <%= f.label :content, "내용", class: "form__label" %>
    <%= f.text_area :content,
          class: "form__textarea today-journal-form__textarea",
          rows: 14,
          required: true,
          placeholder: "오늘 있었던 일, 느낀 점, 내일 챙길 일을 자유롭게 기록해보세요." %>
  </div>

  <div class="form__actions">
    <%= f.submit work_journal.new_record? ? "저장" : "수정", class: "btn btn--primary" %>
    <%= link_to "취소", work_journals_path, class: "btn btn--ghost" %>
  </div>
<% end %>
