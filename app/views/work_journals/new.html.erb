<% content_for :title, "새 일지 만들기" %>

<div class="cl-page today-journal-page">
  <div class="cl-hero cl-hero--game-sessions-banner">
    <div class="cl-hero__inner">
      <p class="cl-hero__eyebrow">
        <%= link_to "오늘하루", work_journals_path %>
        <span class="sep">/</span>
      </p>
      <h1 class="cl-hero__title">새 일지 만들기</h1>
    </div>
  </div>

  <div class="cl-content today-journal-content today-journal-content--form">
    <div class="oss-admin-bar">
      <%= link_to work_journals_path, class: "btn btn--ghost btn--sm" do %>
        <iconify-icon icon="lucide:arrow-left" width="13"></iconify-icon> 오늘하루로
      <% end %>
    </div>

    <section class="today-journal-form-card">
      <div class="today-journal-form-card__header">
        <span class="oss-card__today-badge">오늘</span>
        <div>
          <p class="today-journal-toolbar__label"><%= @date.strftime("%Y년 %-m월 %-d일") %></p>
          <h2 class="today-journal-toolbar__title">오늘 일지 작성</h2>
        </div>
      </div>

      <%= render "form", work_journal: @work_journal %>
    </section>
  </div>
</div>
