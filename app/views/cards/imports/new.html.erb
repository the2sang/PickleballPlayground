<% content_for :title, "카드 붙여넣기 가져오기" %>
<div class="cl-page">
  <div class="cl-content cl-content--form">
    <p class="cl-hero__eyebrow">
      <%= link_to "낱말카드", decks_path %>
      <span class="sep">/</span>
      <%= link_to @deck.title, deck_path(@deck) %>
      <span class="sep">/</span>
      가져오기
    </p>
    <h1 class="cl-hero__title">붙여넣기 가져오기</h1>

    <div class="cl-form-card" data-controller="paste-import">
      <%= form_with url: deck_cards_imports_path(@deck), data: { turbo_stream: "" } do |f| %>
        <div class="cl-form__field">
          <%= f.label :separator, "구분자", class: "cl-form__label" %>
          <%= f.select :separator,
                [["탭", "tab"], ["파이프 |", "pipe"], ["대시 ==", "dash"], ["콤마 ,", "comma"]],
                {}, data: { paste_import_target: "separator" } %>
        </div>
        <div class="cl-form__field">
          <%= f.label :text, "텍스트 (한 줄에 한 카드)", class: "cl-form__label" %>
          <%= f.text_area :text, rows: 10, class: "cl-form__input",
                data: { paste_import_target: "text", action: "input->paste-import#detectSeparator" },
                placeholder: "앞면[Tab]뒷면[Tab]힌트[Tab]태그" %>
        </div>
        <%= f.submit "미리보기", name: "mode", value: "preview", class: "btn btn--primary btn--sm" %>
      <% end %>
    </div>

    <div id="import-preview-<%= @deck.id %>" class="import-preview"></div>
    <div id="import-actions-<%= @deck.id %>" class="import-actions"></div>
  </div>
</div>
