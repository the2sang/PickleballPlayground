<% content_for :title, "관리자 대시보드" %>

<div class="page">
  <div class="page__header">
    <h1 class="title-collage" aria-label="Admin">
      <span class="tc-letter tc-1">A</span><span class="tc-letter tc-2">d</span><span class="tc-letter tc-3">m</span><span class="tc-letter tc-4">i</span><span class="tc-letter tc-5">n</span>
    </h1>
    <div class="page__header-actions">
      <%= link_to admin_users_path, class: "btn btn--secondary btn--sm" do %>
        <iconify-icon icon="lucide:users"></iconify-icon> 회원
      <% end %>
      <%= link_to admin_groups_path, class: "btn btn--secondary btn--sm" do %>
        <iconify-icon icon="lucide:users"></iconify-icon> 그룹
      <% end %>
      <%= link_to admin_sessions_path, class: "btn btn--secondary btn--sm" do %>
        <iconify-icon icon="lucide:history"></iconify-icon> 접속이력
      <% end %>
    </div>
  </div>

  <div class="admin-stats">
    <div class="admin-stats__card">
      <div class="admin-stats__label">전체 회원</div>
      <div class="admin-stats__value"><%= number_with_delimiter(@user_count) %></div>
    </div>
    <div class="admin-stats__card">
      <div class="admin-stats__label">관리자</div>
      <div class="admin-stats__value"><%= @admin_count %></div>
    </div>
    <div class="admin-stats__card">
      <div class="admin-stats__label">신규 (7일)</div>
      <div class="admin-stats__value"><%= @new_users_this_week %></div>
    </div>
    <div class="admin-stats__card">
      <div class="admin-stats__label">접속 (24h)</div>
      <div class="admin-stats__value"><%= @sessions_today %></div>
    </div>
    <div class="admin-stats__card bg-yellow-50 border border-yellow-200">
      <div class="admin-stats__label text-yellow-800">클럽 승인 대기</div>
      <div class="admin-stats__value text-yellow-600"><%= Club.pending.count %></div>
      <%= link_to "관리하기 →", admin_clubs_path, class: "text-sm text-yellow-700 hover:underline" %>
    </div>
    <div class="admin-stats__card bg-yellow-50 border border-yellow-200">
      <div class="admin-stats__label text-yellow-800">덱 추가 승인요청</div>
      <div class="admin-stats__value text-yellow-600"><%= @pending_deck_addition_requests.size %></div>
    </div>
  </div>

  <div class="admin-grid">
    <section class="admin-panel" id="deck-community">
      <div class="admin-panel__header">
        <h2 class="admin-panel__title">덱 커뮤니티 오픈 카톡방</h2>
      </div>
      <%= form_with model: @site_setting,
            url: admin_site_setting_path,
            method: :patch,
            class: "admin-setting-form" do |f| %>
        <div class="admin-setting-form__field">
          <%= f.label :deck_community_open_chat_url, "접속 URL", class: "form__label" %>
          <%= f.url_field :deck_community_open_chat_url,
                class: "form__input",
                placeholder: "https://open.kakao.com/o/..." %>
        </div>
        <div class="admin-setting-form__footer">
          <% if @site_setting.updated_by.present? %>
            <span class="admin-setting-form__meta">
              마지막 수정: <%= @site_setting.updated_by.nickname %> · <%= @site_setting.updated_at.strftime("%Y-%m-%d %H:%M") %>
            </span>
          <% end %>
          <%= f.submit "저장", class: "btn btn--primary btn--sm" %>
        </div>
      <% end %>
    </section>

    <section class="admin-panel">
      <div class="admin-panel__header">
        <h2 class="admin-panel__title">덱 추가 승인요청</h2>
      </div>
      <% if @pending_deck_addition_requests.any? %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>사용자</th>
              <th>현재 덱</th>
              <th>요청 한도</th>
              <th>요청일</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @pending_deck_addition_requests.each do |request| %>
              <tr>
                <td>
                  <%= link_to request.user.nickname, admin_user_path(request.user) %><br>
                  <span class="admin-table__mono"><%= request.user.email_address %></span>
                </td>
                <td><%= request.user.personal_deck_count %>개</td>
                <td><%= request.requested_limit %>개</td>
                <td><%= request.created_at.strftime("%Y-%m-%d %H:%M") %></td>
                <td>
                  <%= button_to "허용",
                        admin_deck_addition_request_path(request),
                        method: :patch,
                        class: "btn btn--primary btn--sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="empty-state">대기 중인 덱 추가 승인요청이 없습니다.</p>
      <% end %>
    </section>

    <section class="admin-panel">
      <div class="admin-panel__header">
        <h2 class="admin-panel__title">최근 가입</h2>
        <%= link_to "전체 보기", admin_users_path, class: "admin-panel__link" %>
      </div>
      <% if @recent_users.any? %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>닉네임</th>
              <th>이메일</th>
              <th>권한</th>
              <th>가입일</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_users.each do |user| %>
              <tr>
                <td><%= link_to user.nickname, admin_user_path(user) %></td>
                <td class="admin-table__mono"><%= user.email_address %></td>
                <td>
                  <% if user.admin? %>
                    <span class="admin-badge admin-badge--admin">ROLE_ADMIN</span>
                  <% elsif user.club? %>
                    <span class="admin-badge admin-badge--club">ROLE_CLUB</span>
                  <% else %>
                    <span class="admin-badge">ROLE_USER</span>
                  <% end %>
                </td>
                <td><%= user.created_at.strftime("%Y-%m-%d") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="empty-state">데이터가 없습니다.</p>
      <% end %>
    </section>

    <section class="admin-panel">
      <div class="admin-panel__header">
        <h2 class="admin-panel__title">최근 접속</h2>
        <%= link_to "전체 보기", admin_sessions_path, class: "admin-panel__link" %>
      </div>
      <% if @recent_sessions.any? %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>사용자</th>
              <th>IP</th>
              <th>시각</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_sessions.each do |session| %>
              <tr>
                <td><%= link_to session.user.nickname, admin_user_path(session.user) %></td>
                <td class="admin-table__mono"><%= format_ip_address(session.ip_address) %></td>
                <td><%= session.created_at.strftime("%Y-%m-%d %H:%M") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="empty-state">데이터가 없습니다.</p>
      <% end %>
    </section>
  </div>
</div>
