<% content_for :title, "데이터 관리" %>

<div class="page"
     data-controller="sql-console"
     data-sql-console-execute-url-value="<%= admin_data_management_execute_path %>"
     data-sql-console-csrf-token-value="<%= form_authenticity_token %>">

  <div class="page__header">
    <h1 class="page__title" style="display:flex;align-items:center;gap:8px;">
      <iconify-icon icon="lucide:database" style="color:var(--hcp-purple);"></iconify-icon>
      데이터 관리
    </h1>
    <div class="page__header-actions">
      <%= link_to admin_root_path, class: "btn btn--ghost btn--sm" do %>
        <iconify-icon icon="lucide:arrow-left"></iconify-icon> 대시보드
      <% end %>
    </div>
  </div>

  <% if notice.present? || alert.present? %>
    <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:16px;">
      <% if notice.present? %>
        <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:12px 16px;font-size:13px;color:#166534;">
          <iconify-icon icon="lucide:check-circle" style="vertical-align:-2px;margin-right:6px;"></iconify-icon>
          <%= notice %>
        </div>
      <% end %>
      <% if alert.present? %>
        <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:12px 16px;font-size:13px;color:#991b1b;">
          <iconify-icon icon="lucide:triangle-alert" style="vertical-align:-2px;margin-right:6px;"></iconify-icon>
          <%= alert %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# 경고 배너 %>
  <div style="display:flex;align-items:flex-start;gap:10px;padding:12px 16px;
              background:#fef2f2;border:1px solid #fecaca;border-radius:8px;margin-bottom:24px;">
    <iconify-icon icon="lucide:triangle-alert" style="font-size:16px;color:#dc2626;flex-shrink:0;margin-top:1px;"></iconify-icon>
    <p style="font-size:13px;color:#991b1b;line-height:1.5;margin:0;">
      <strong>주의:</strong> 운영 DB에 직접 실행됩니다. DML(INSERT·UPDATE·DELETE) 실행 전 반드시 SELECT로 대상 데이터를 확인하세요.
      모든 실행 내역은 서버 로그에 기록됩니다.
    </p>
  </div>

  <%# DB 백업 영역 %>
  <div id="db-backups" class="admin-table" style="margin-bottom:24px;border-radius:10px;overflow:hidden;">
    <div style="padding:14px 16px;background:var(--hcp-surface,#f5f5f7);border-bottom:1px solid var(--hcp-border-light);
                display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
      <div>
        <span style="display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--hcp-mid-gray);text-transform:uppercase;letter-spacing:0.06em;">
          <iconify-icon icon="lucide:archive" style="font-size:14px;color:#2563eb;"></iconify-icon>
          DB 백업
        </span>
        <p style="font-size:12px;color:var(--hcp-cool-gray);line-height:1.5;margin:6px 0 0;">
          기본 백업은 SQLite 파일로 생성합니다. SQL dump는 사람이 확인하거나 부분 복구할 때 사용할 수 있는 고급 옵션입니다.
        </p>
      </div>

      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
        <%= form_with url: admin_data_management_backups_path, method: :post, local: true,
                      style: "display:flex;align-items:center;gap:12px;flex-wrap:wrap;" do %>
          <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--hcp-mid-gray);">
            <%= check_box_tag :include_sql_dump, "1", false %>
            SQL dump 포함
          </label>
          <button class="btn btn--primary btn--sm" type="submit">
            <iconify-icon icon="lucide:database-backup" style="font-size:13px;"></iconify-icon>
            백업 생성
          </button>
        <% end %>

        <%= form_with url: admin_data_management_postgresql_backups_path, method: :post, local: true do %>
          <button class="btn btn--ghost btn--sm" type="submit">
            <iconify-icon icon="lucide:database-backup" style="font-size:13px;"></iconify-icon>
            Postgresql 전환 백업생성
          </button>
        <% end %>
      </div>
    </div>

    <div style="padding:14px 16px;border-bottom:1px solid var(--hcp-border-light);background:#f8fafc;">
      <p style="font-size:12px;color:#475569;line-height:1.55;margin:0;">
        운영 Railway 환경의 재해복구는 Railway 서비스 Backups 탭의 Volume 백업/복구를 1차 수단으로 사용하세요.
        이 페이지의 백업 파일은 관리자 다운로드 및 별도 보관용입니다.
      </p>
    </div>

    <% if @database_backups.any? %>
      <div style="overflow:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
          <thead>
            <tr style="background:#fff;">
              <th style="text-align:left;padding:12px 16px;border-bottom:1px solid var(--hcp-border-light);font-weight:600;color:var(--hcp-mid-gray);">생성 시각</th>
              <th style="text-align:left;padding:12px 16px;border-bottom:1px solid var(--hcp-border-light);font-weight:600;color:var(--hcp-mid-gray);">파일</th>
              <th style="text-align:left;padding:12px 16px;border-bottom:1px solid var(--hcp-border-light);font-weight:600;color:var(--hcp-mid-gray);">생성자</th>
            </tr>
          </thead>
          <tbody>
            <% @database_backups.each do |backup| %>
              <tr>
                <td style="padding:12px 16px;border-bottom:1px solid var(--hcp-border-light);white-space:nowrap;color:var(--hcp-charcoal);">
                  <%= backup["created_at"].strftime("%Y-%m-%d %H:%M") %>
                </td>
                <td style="padding:12px 16px;border-bottom:1px solid var(--hcp-border-light);">
                  <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <% backup["files"].each do |file| %>
                      <%= link_to admin_data_management_backup_path(id: backup["id"], file: file["name"]),
                                  class: "btn btn--ghost btn--sm",
                                  style: "font-size:11px;" do %>
                        <iconify-icon icon="lucide:download" style="font-size:12px;"></iconify-icon>
                        <%= file["type"] %>
                        <span style="color:var(--hcp-cool-gray);">(<%= number_to_human_size(file["size_bytes"]) %>)</span>
                      <% end %>
                    <% end %>
                  </div>
                </td>
                <td style="padding:12px 16px;border-bottom:1px solid var(--hcp-border-light);color:var(--hcp-cool-gray);">
                  <%= backup.dig("created_by", "email_address") || "-" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div style="padding:20px;text-align:center;color:var(--hcp-cool-gray);font-size:13px;">
        아직 생성된 DB 백업이 없습니다.
      </div>
    <% end %>
  </div>

  <%# 운영 백업 개발 복원 영역 %>
  <div id="db-restore" class="admin-table" style="margin-bottom:24px;border-radius:10px;overflow:hidden;border-color:#bfdbfe;">
    <div style="padding:14px 16px;background:#eff6ff;border-bottom:1px solid #bfdbfe;
                display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;">
      <div>
        <span style="display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:#1d4ed8;text-transform:uppercase;letter-spacing:0.06em;">
          <iconify-icon icon="lucide:upload-cloud" style="font-size:14px;color:#2563eb;"></iconify-icon>
          운영 백업 업로드 복원
        </span>
        <p style="font-size:12px;color:#1e3a8a;line-height:1.5;margin:6px 0 0;">
          운영 서버에서 생성한 DB 백업 zip 또는 sqlite3 파일을 개발 서버에 업로드해 현재 개발 DB를 교체합니다.
          복원 전 현재 개발 DB 백업을 자동으로 생성합니다.
        </p>
      </div>
    </div>

    <% if Rails.env.production? %>
      <div style="padding:14px 16px;background:#fff;color:#64748b;font-size:13px;line-height:1.55;">
        이 기능은 개발/테스트 환경에서만 사용할 수 있습니다. 운영 환경에서는 DB 복원이 비활성화됩니다.
      </div>
    <% else %>
      <div style="padding:14px 16px;background:#fff;">
        <%= form_with url: admin_data_management_backup_restore_path,
                      method: :post,
                      local: true,
                      multipart: true,
                      style: "display:grid;gap:12px;" do %>
          <div style="display:grid;gap:6px;">
            <label for="backup_file" style="font-size:12px;font-weight:600;color:var(--hcp-mid-gray);">
              백업 파일
            </label>
            <%= file_field_tag :backup_file,
                               accept: ".zip,.sqlite3,.sqlite,.db,application/zip",
                               required: true,
                               style: "font-size:13px;" %>
          </div>

          <label style="display:flex;align-items:flex-start;gap:8px;font-size:12px;color:#991b1b;line-height:1.5;">
            <%= check_box_tag :confirm_restore, "1", false, required: true, style: "margin-top:2px;" %>
            현재 개발 DB가 업로드한 운영 백업으로 교체된다는 것을 확인했습니다.
          </label>

          <div style="display:flex;justify-content:flex-end;">
            <button class="btn btn--primary btn--sm"
                    type="submit"
                    onclick="return confirm('현재 개발 DB를 업로드한 백업으로 교체합니다. 계속할까요?')">
              <iconify-icon icon="lucide:database-zap" style="font-size:13px;"></iconify-icon>
              업로드 후 복원
            </button>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# SQL 입력 영역 %>
  <div class="admin-table" style="margin-bottom:0;border-radius:10px 10px 0 0;overflow:hidden;">
    <div style="padding:14px 16px;background:var(--hcp-surface,#f5f5f7);border-bottom:1px solid var(--hcp-border-light);
                display:flex;align-items:center;justify-content:space-between;">
      <span style="font-size:12px;font-weight:600;color:var(--hcp-mid-gray);text-transform:uppercase;letter-spacing:0.06em;">
        SQL 편집기
      </span>
      <div style="display:flex;gap:8px;align-items:center;">
        <span style="font-size:11px;color:var(--hcp-cool-gray);">Ctrl+Enter로 실행</span>
        <button class="btn btn--ghost btn--sm"
                data-action="click->sql-console#clear"
                type="button">
          <iconify-icon icon="lucide:rotate-ccw" style="font-size:13px;"></iconify-icon>
          초기화
        </button>
      </div>
    </div>
    <textarea
      data-sql-console-target="input"
      data-action="keydown->sql-console#keydown"
      placeholder="SELECT * FROM users LIMIT 10;"
      spellcheck="false"
      style="width:100%;min-height:160px;padding:16px;font-family:'Courier New',Courier,monospace;
             font-size:13px;line-height:1.6;border:none;resize:vertical;outline:none;
             background:#1e1e2e;color:#cdd6f4;tab-size:2;"></textarea>
    <div style="padding:12px 16px;background:var(--hcp-surface,#f5f5f7);border-top:1px solid var(--hcp-border-light);
                display:flex;align-items:center;gap:12px;">
      <button class="btn btn--primary btn--sm"
              data-action="click->sql-console#execute"
              data-sql-console-target="runBtn"
              type="button">
        <iconify-icon icon="lucide:play" style="font-size:13px;"></iconify-icon>
        실행
      </button>

      <%# 빠른 쿼리 버튼 %>
      <div style="display:flex;gap:6px;flex-wrap:wrap;">
        <% [
          ["users", "SELECT id, email_address, nickname, role, created_at FROM users ORDER BY created_at DESC LIMIT 20;"],
          ["clubs", "SELECT id, name, status, owner_id, created_at FROM clubs ORDER BY created_at DESC LIMIT 20;"],
          ["club_memberships", "SELECT cm.id, u.email_address, c.name AS club_name, cm.role, cm.status FROM club_memberships cm JOIN users u ON u.id=cm.user_id JOIN clubs c ON c.id=cm.club_id ORDER BY cm.created_at DESC LIMIT 20;"],
        ].each do |label, query| %>
          <button class="btn btn--ghost btn--sm"
                  style="font-size:11px;"
                  data-action="click->sql-console#preset"
                  data-sql-console-query-param="<%= query %>"
                  type="button">
            <%= label %>
          </button>
        <% end %>
      </div>
    </div>
  </div>

  <%# 결과 영역 %>
  <div data-sql-console-target="result"
       style="border:1px solid var(--hcp-border-light);border-top:none;
              border-radius:0 0 10px 10px;min-height:80px;overflow:auto;">
    <div style="padding:20px;text-align:center;color:var(--hcp-cool-gray);font-size:13px;">
      SQL을 입력하고 실행 버튼을 누르세요.
    </div>
  </div>

  <%# 실행 이력 %>
  <div style="margin-top:32px;">
    <p style="font-size:12px;font-weight:600;color:var(--hcp-mid-gray);text-transform:uppercase;
              letter-spacing:0.06em;margin-bottom:12px;">실행 이력 (세션 내)</p>
    <div data-sql-console-target="history"
         style="font-size:12px;font-family:'Courier New',Courier,monospace;
                background:#1e1e2e;color:#a6e3a1;border-radius:8px;padding:16px;
                max-height:200px;overflow-y:auto;white-space:pre-wrap;word-break:break-all;">
      <span style="color:#585b70;">-- 실행 이력이 여기에 표시됩니다 --</span>
    </div>
  </div>
</div>
