<% content_for :title, "2026년 국가 보안 표어/표스터 공모전 시행" %>

<div class="min-h-screen bg-slate-50 py-10 px-4 sm:px-6 lg:px-8" data-controller="vote">
  <div class="max-w-4xl mx-auto">
    
    <%# Hero Banner %>
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-tr from-violet-800 via-indigo-900 to-purple-950 text-white shadow-xl mb-8 p-8 sm:p-12">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-white/10 via-transparent to-transparent pointer-events-none"></div>
      <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-violet-500/20 border border-violet-400/30 text-violet-200 mb-4">
            <iconify-icon icon="lucide:shield-check" class="text-sm"></iconify-icon>
            국가보안 특별캠페인
          </span>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">
            2026년 국가 보안 표어/표스터 공모전 시행
          </h1>
          <p class="text-indigo-200 text-sm sm:text-base max-w-xl leading-relaxed">
            보안은 거창한 구호가 아니라 눈으로 직접 확인하는 작은 실천에서 시작됩니다.<br class="hidden sm:inline">
            아래의 표어 중 가장 마음에 드는 표어를 선택하고 본인의 이름을 등록해 주세요.
          </p>
        </div>
        <div class="flex flex-row md:flex-col gap-4 bg-white/5 backdrop-blur-md rounded-2xl p-5 border border-white/10 w-full md:w-auto text-center md:text-left">
          <div class="flex-1 md:flex-none">
            <p class="text-indigo-300 text-xs uppercase tracking-wider font-semibold">전체 표어</p>
            <p class="text-2xl font-bold text-white"><%= SloganVote::SLOGANS.size %>개</p>
          </div>
          <div class="h-8 w-px bg-white/10 md:h-px md:w-full my-auto md:my-1"></div>
          <div class="flex-1 md:flex-none">
            <p class="text-indigo-300 text-xs uppercase tracking-wider font-semibold">선택 완료</p>
            <p class="text-2xl font-bold text-violet-300"><%= @votes_by_number.size %>개</p>
          </div>
        </div>
      </div>

      <%# Progress Bar %>
      <div class="relative mt-8 pt-4 border-t border-white/10">
        <div class="flex justify-between text-xs text-indigo-200 mb-2">
          <span>참여 진행률</span>
          <span><%= (@votes_by_number.size.to_f / SloganVote::SLOGANS.size * 100).round(1) %>%</span>
        </div>
        <div class="h-2.5 bg-white/15 rounded-full overflow-hidden">
          <div class="h-full bg-gradient-to-r from-violet-400 to-fuchsia-400 rounded-full transition-all duration-500" style="width: <%= (@votes_by_number.size.to_f / SloganVote::SLOGANS.size * 100) %>%"></div>
        </div>
      </div>
    </div>

    <%# Flash Messages %>
    <% if flash[:notice].present? %>
      <div class="mb-6 flex items-center gap-3 p-4 rounded-xl border border-green-200 bg-green-50 text-green-800 shadow-sm animate-fade-in">
        <iconify-icon icon="lucide:circle-check" class="text-xl text-green-600 flex-shrink-0"></iconify-icon>
        <span class="text-sm font-semibold"><%= flash[:notice] %></span>
      </div>
    <% end %>
    
    <% if flash[:alert].present? %>
      <div class="mb-6 flex items-center gap-3 p-4 rounded-xl border border-rose-200 bg-rose-50 text-rose-800 shadow-sm animate-fade-in">
        <iconify-icon icon="lucide:circle-alert" class="text-xl text-rose-600 flex-shrink-0"></iconify-icon>
        <span class="text-sm font-semibold"><%= flash[:alert] %></span>
      </div>
    <% end %>

    <%# Search and Filter Toolbar %>
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4 mb-6 flex flex-col sm:flex-row gap-4 items-center justify-between">
      <div class="relative w-full sm:max-w-md">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <iconify-icon icon="lucide:search" class="text-lg"></iconify-icon>
        </div>
        <input type="text" 
               data-vote-target="searchInput" 
               data-action="input->vote#search" 
               placeholder="표어 내용, 번호, 선택자 이름 검색..." 
               class="block w-full pl-10 pr-10 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-violet-500 transition-all">
        <button type="button" 
                data-action="click->vote#clearSearch" 
                class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 transition-colors">
          <iconify-icon icon="lucide:x" class="text-base"></iconify-icon>
        </button>
      </div>
      <div class="flex gap-2 text-xs font-medium text-slate-500 w-full sm:w-auto justify-end">
        <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-indigo-600 inline-block"></span> 선택가능</span>
        <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-slate-300 inline-block"></span> 선택완료 (취소선)</span>
      </div>
    </div>

    <%# Slogan List %>
    <div class="space-y-3">
      <% SloganVote::SLOGANS.each_with_index do |slogan, index| %>
        <% slogan_number = index + 1 %>
        <% vote = @votes_by_number[slogan_number] %>
        
        <div id="slogan_<%= slogan_number %>" 
             data-vote-target="sloganRow"
             data-slogan-number="<%= slogan_number %>"
             data-slogan-text="<%= slogan %>"
             data-voter-name="<%= vote&.voter_name %>"
             class="group relative flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-5 rounded-2xl border transition-all duration-300 <%= vote.present? ? 'bg-slate-50/70 border-slate-200' : 'bg-white border-slate-100 hover:border-violet-200 hover:shadow-md hover:-translate-y-0.5' %>">
          
          <div class="flex items-start gap-4 flex-1">
            <%# Number Badge %>
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl text-sm font-bold flex-shrink-0 <%= vote.present? ? 'bg-slate-200 text-slate-500' : 'bg-violet-100 text-violet-700' %>">
              <%= slogan_number %>
            </span>

            <%# Slogan text %>
            <div class="pt-1 sm:pt-0">
              <% if vote.present? %>
                <p class="text-slate-400 line-through decoration-slate-300 decoration-1 text-base leading-relaxed break-all">
                  <%= slogan %>
                </p>
                <div class="mt-1.5 inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-200/60 text-slate-600 border border-slate-300/30">
                  <iconify-icon icon="lucide:user" class="text-[11px]"></iconify-icon>
                  선택자: <%= vote.voter_name %>
                </div>
              <% else %>
                <p class="text-slate-800 text-base font-medium leading-relaxed group-hover:text-slate-900 break-all transition-colors">
                  <%= slogan %>
                </p>
              <% end %>
            </div>
          </div>

          <%# Action / Status %>
          <div class="w-full sm:w-auto flex justify-end flex-shrink-0 pt-2 sm:pt-0 border-t border-slate-100 sm:border-t-0">
            <% if vote.present? %>
              <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-semibold bg-slate-100 text-slate-400 select-none border border-slate-200/50">
                <iconify-icon icon="lucide:lock" class="text-base"></iconify-icon>
                선택 완료
              </span>
            <% else %>
              <button type="button" 
                      data-action="click->vote#selectSlogan"
                      data-vote-number-param="<%= slogan_number %>"
                      data-vote-text-param="<%= slogan %>"
                      class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl text-sm font-semibold bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm hover:shadow-md transition-all active:scale-[0.98]">
                선택하기
                <iconify-icon icon="lucide:chevron-right" class="text-sm"></iconify-icon>
              </button>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Empty State Search Results %>
    <div id="no-results" data-vote-target="noResults" class="hidden text-center py-16 bg-white rounded-3xl border border-slate-100 shadow-sm mt-8">
      <iconify-icon icon="lucide:search-code" class="text-5xl text-slate-300 mb-3"></iconify-icon>
      <p class="text-slate-500 font-medium">검색 결과와 일치하는 표어가 없습니다.</p>
    </div>

  </div>

  <%# Modal dialog %>
  <dialog data-vote-target="modal" 
          data-action="click->vote#backdropClose" 
          class="backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm rounded-2xl shadow-2xl p-0 border border-slate-100 max-w-md w-full overflow-hidden animate-zoom-in">
    <div class="relative bg-white p-6 sm:p-8">
      
      <%# Modal Close Button %>
      <button type="button" 
              data-action="click->vote#close" 
              class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-100 transition-all" 
              aria-label="닫기">
        <iconify-icon icon="lucide:x" class="text-xl"></iconify-icon>
      </button>

      <%# Modal Header %>
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-violet-100 text-violet-700">
          <iconify-icon icon="lucide:vote" class="text-xl"></iconify-icon>
        </span>
        <div>
          <h3 class="text-lg font-bold text-slate-900">표어 선택 확인</h3>
          <p class="text-xs text-slate-500">선택자 이름을 입력하고 등록을 완료해 주세요.</p>
        </div>
      </div>

      <%# Slogan Info Box %>
      <div class="bg-violet-50/50 border border-violet-100 rounded-xl p-4 mb-6">
        <span data-vote-target="sloganNumberDisplay" class="text-xs font-extrabold text-violet-700 block mb-1">#00</span>
        <p data-vote-target="sloganTextDisplay" class="text-sm font-semibold text-slate-800 leading-relaxed"></p>
      </div>

      <%# Form %>
      <%= form_with model: @slogan_vote, url: votes_path, local: true, class: "space-y-5" do |f| %>
        <%= f.hidden_field :slogan_number, data: { vote_target: "sloganNumberField" } %>

        <div>
          <%= f.label :voter_name, "본인 이름", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2" %>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <iconify-icon icon="lucide:user" class="text-base"></iconify-icon>
            </div>
            <%= f.text_field :voter_name, 
                             data: { vote_target: "voterNameField" }, 
                             required: true,
                             placeholder: "성함을 입력하세요 (예: 홍길동)", 
                             class: "block w-full pl-10 pr-4 py-3 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-violet-500 transition-all placeholder:text-slate-400" %>
          </div>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <button type="button" 
                  data-action="click->vote#close" 
                  class="flex-1 py-3 px-4 border border-slate-200 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
            취소
          </button>
          <%= f.submit "저장 및 등록", 
                       class: "flex-1 py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-sm font-semibold shadow-sm hover:shadow transition-all active:scale-[0.98] cursor-pointer text-center" %>
        </div>
      <% end %>

    </div>
  </dialog>
</div>

<%# Simple styles for dialog animations %>
<style>
  @keyframes zoomIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
  dialog[open] {
    animation: zoomIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
