<%
  event     = @match.tournament_event
  is_group  = @match.matchable.is_a?(TournamentGroup)
  best_of_3 = event.best_of_3?
  set_count = best_of_3 ? 3 : 1
%>
<% content_for :title, "결과 입력" %>

<div class="cl-page">
  <div class="cl-hero"><div class="cl-hero__inner">
    <p class="cl-hero__eyebrow">
      <%= link_to event.tournament.name, tournament_path(event.tournament) %> /
      <%= link_to event.discipline.humanize, tournament_event_path(event) %> /
      <% if is_group %>
        <%= link_to @match.matchable.name, tournament_group_path(@match.matchable) %> /
      <% end %>
      <%= link_to "경기 보기", match_path(@match) %>
    </p>
    <h1 class="cl-hero__title">결과 입력</h1>
    <p class="cl-hero__subtitle">
      <%= @match.home_team&.name || "BYE" %> vs <%= @match.away_team&.name || "BYE" %>
    </p>
  </div></div>

  <div class="cl-content" style="max-width:540px;">
    <div class="cl-info-card">
      <%= form_with url: match_path(@match), method: :patch, class: "cl-form" do |f| %>
        <%= hidden_field_tag :return_to, @return_to if @return_to.present? %>

        <div style="overflow-x:auto;padding-bottom:8px;">
          <table style="width:100%;border-collapse:collapse;font-size:14px;">
            <thead>
              <tr style="border-bottom:2px solid var(--hcp-border,#e5e7eb);">
                <th style="padding:8px 16px;text-align:left;font-weight:500;color:var(--hcp-cool-gray);">팀</th>
                <% set_count.times do |i| %>
                  <th style="padding:8px 12px;text-align:center;font-weight:500;color:var(--hcp-cool-gray);">
                    세트 <%= i + 1 %><% if best_of_3 && i == 2 %> (선택)<% end %>
                  </th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom:1px solid var(--hcp-border,#e5e7eb);">
                <td style="padding:10px 16px;font-weight:500;"><%= @match.home_team&.name || "BYE" %></td>
                <% set_count.times do |i| %>
                  <td style="padding:6px 12px;text-align:center;">
                    <%= number_field_tag "sets[#{i}][home_score]",
                          @sets[i]&.home_score,
                          min: 0, max: 99,
                          class: "cl-form__input",
                          style: "width:64px;text-align:center;",
                          placeholder: "0" %>
                  </td>
                <% end %>
              </tr>
              <tr>
                <td style="padding:10px 16px;font-weight:500;"><%= @match.away_team&.name || "BYE" %></td>
                <% set_count.times do |i| %>
                  <td style="padding:6px 12px;text-align:center;">
                    <%= number_field_tag "sets[#{i}][away_score]",
                          @sets[i]&.away_score,
                          min: 0, max: 99,
                          class: "cl-form__input",
                          style: "width:64px;text-align:center;",
                          placeholder: "0" %>
                  </td>
                <% end %>
              </tr>
            </tbody>
          </table>
        </div>

        <% if best_of_3 %>
          <p style="padding:8px 16px;font-size:12px;color:var(--hcp-cool-gray);">
            3세트는 2-0으로 끝나는 경우 비워 두세요.
          </p>
        <% end %>

        <div style="display:flex;gap:8px;padding:12px 16px 4px;">
          <%= f.submit "저장", class: "btn btn--primary" %>
          <%= link_to "취소", (@return_to.presence || match_path(@match)), class: "btn btn--secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
