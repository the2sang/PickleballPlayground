<%= form_with model: [ @club, @club_notice ], class: "cl-form" do |f| %>
  <% if @club_notice.errors.any? %>
    <div class="cl-form__error">
      <% @club_notice.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="cl-form__field">
    <%= f.label :title, "제목", class: "cl-form__label" %>
    <%= f.text_field :title, class: "cl-form__input", maxlength: 80, placeholder: "예: 이번 주 코트 배정 안내" %>
  </div>

  <div class="cl-form__field">
    <%= f.label :body, "내용", class: "cl-form__label" %>
    <%= f.text_area :body, rows: 8, class: "cl-form__textarea", placeholder: "회원에게 전달할 공지사항을 입력하세요." %>
  </div>

  <div class="cl-form__field">
    <%= f.label :published_at, "공지 일시 (선택)", class: "cl-form__label" %>
    <%= f.datetime_local_field :published_at, class: "cl-form__input" %>
  </div>

  <div style="display:flex;gap:8px;justify-content:flex-end;align-items:center;">
    <%= link_to "취소", manage_club_path(@club, anchor: "club-notices"), class: "btn btn--ghost" %>
    <%= f.submit "저장", class: "cl-form__submit", style: "width:auto;margin-top:0;" %>
  </div>
<% end %>
