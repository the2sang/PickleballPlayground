<% content_for :title, "#{@club.name} 오픈 게임" %>

<div class="cl-page">
  <div class="cl-hero">
    <div class="cl-hero__inner">
      <p class="cl-hero__eyebrow">
        <%= link_to @club.name, club_path(@club) %>
        <span class="sep">/</span>
      </p>
      <h1 class="cl-hero__title">오픈 게임 세션</h1>
    </div>
  </div>

  <div class="cl-content" style="max-width:760px;">
    <% if @can_manage %>
      <div class="oss-admin-bar">
        <%= link_to new_game_session_path(club_id: @club.id), class: "btn btn--primary btn--sm" do %>
          <iconify-icon icon="lucide:plus" width="13"></iconify-icon> 새 세션 만들기
        <% end %>
        <% if @game_sessions.present? %>
          <%= button_to club_open_sessions_path(@club),
                params: { copy_from: @game_sessions.last.id },
                class: "btn btn--secondary btn--sm",
                form: { data: { turbo_confirm: "마지막 세션을 복사해 새 세션을 추가할까요?" } } do %>
            <iconify-icon icon="lucide:copy-plus" width="13"></iconify-icon> 세션 추가
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if @game_sessions.empty? %>
      <div class="cl-info-card" style="margin-top:16px;">
        <p style="padding:24px 16px;text-align:center;color:var(--hcp-cool-gray);font-size:14px;">
          등록된 오픈 게임 세션이 없습니다.
        </p>
      </div>
    <% else %>
      <div class="oss" data-controller="accordion">
        <% @game_sessions.group_by(&:scheduled_date).each do |date, sessions| %>
          <section class="oss-day">
            <h2 class="oss-day__title">
              <iconify-icon icon="lucide:calendar" width="15"></iconify-icon>
              <%= format_session_date(date, style: :long) %>
            </h2>
            <% sessions.each do |session| %>
              <%= render "open_sessions/court_card", session: session, can_manage: @can_manage %>
            <% end %>
          </section>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%= render "open_sessions/styles" %>
