<%#
  코트 단위 오픈 게임 세션 카드 (아코디언 항목).
  locals: session (GameSession), can_manage (Boolean)
%>
<%
  confirmed  = session.participations.select(&:confirmed?).sort_by(&:created_at)
  waitlisted = session.participations.select(&:waitlisted?).sort_by(&:created_at)
  capacity   = session.max_participants || GameSession::SLOT_LIMIT
  my_participation = Current.user &&
    session.participations.find { |p| p.user_id == Current.user.id && !p.cancelled? }
  can_apply = Current.user.present? && session.open? && my_participation.nil? && !session.session_started?
  is_today  = session.scheduled_date == Date.today
  is_target_session = params[:open_session_id].to_s == session.id.to_s
  is_expanded = is_today || is_target_session
  return_path = club_open_sessions_path(session.club, open_session_id: session.id, anchor: "open_session_#{session.id}")
%>
<article id="open_session_<%= session.id %>"
         class="oss-card <%= "oss-card--today" if is_today %>"
         data-accordion-target="item">
  <button type="button"
          class="oss-card__header"
          aria-expanded="<%= is_expanded %>"
          data-action="accordion#toggle">
    <span class="oss-card__heading">
      <% if is_today %>
        <span class="oss-card__today-badge">오늘</span>
      <% end %>
      <span class="oss-card__court"><%= session.court_name.presence || "코트 미지정" %></span>
      <span class="cl-badge cl-badge--neutral oss-card__level"><%= session.level_label %></span>
    </span>
    <span class="oss-card__meta">
      <span class="oss-card__time">
        <%= session.start_time.strftime("%H:%M") %>-<%= session.end_time.strftime("%H:%M") %>
      </span>
      <span class="oss-card__count"><%= confirmed.size %>/<%= capacity %></span>
      <% if session.session_ended? %>
        <span class="cl-badge oss-status oss-status--ended">종료</span>
      <% elsif session.open? && !session.session_started? %>
        <span class="cl-badge cl-badge--dark oss-status oss-status--open">모집중</span>
      <% else %>
        <span class="cl-badge cl-badge--neutral oss-status oss-status--closed">마감</span>
      <% end %>
      <iconify-icon class="oss-card__chevron" icon="lucide:chevron-down" width="18"></iconify-icon>
    </span>
  </button>

  <div class="oss-card__panel" data-accordion-target="panel" <%= "hidden" unless is_expanded %>
       <%= tag.attributes(data: { controller: "modal" }) if can_apply %>>
    <p class="oss-card__title"><%= session.title %></p>

    <div class="oss-summary">
      <span>레벨 : <strong><%= session.level_label %></strong></span>
      <span>코트명 : <strong><%= session.court_name.presence || "—" %></strong></span>
      <span>정원 : <strong><%= capacity %></strong></span>
      <span>신청 : <strong><%= confirmed.size %></strong></span>
      <% if session.waitlist_capacity.positive? %>
        <span>대기 : <strong><%= waitlisted.size %>/<%= session.waitlist_capacity %></strong></span>
      <% end %>
    </div>

    <%= render "open_sessions/slot_grid",
          session: session, confirmed: confirmed, waitlisted: waitlisted,
          capacity: capacity, my_participation: my_participation, can_apply: can_apply %>

    <% if my_participation %>
      <div class="oss-mine-bar">
        <span class="oss-mine-bar__label">
          <iconify-icon icon="lucide:check-circle" width="13"></iconify-icon>
          <%= my_participation.waitlisted? ? "대기 신청됨" : "참가 신청됨" %>
        </span>
        <% if policy(my_participation).destroy? %>
          <%= button_to game_session_participation_path(session, my_participation),
                method: :delete,
                params: { return_to: return_path },
                class: "btn btn--secondary btn--sm",
                form: { data: { turbo_confirm: "참가 신청을 취소하시겠습니까?" } } do %>
            <iconify-icon icon="lucide:x-circle" width="12"></iconify-icon> 신청 취소
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if can_apply %>
      <%= render "open_sessions/apply_modal", session: session %>
    <% end %>

    <p class="oss-guide">
      <iconify-icon icon="lucide:info" width="12"></iconify-icon>
      대기자는 정원 신청자 중 취소가 발생하면 순번에 따라 빈 자리로 이동합니다.
    </p>

    <% applicants = confirmed + waitlisted %>
    <% if applicants.any? %>
      <p class="oss-applicants">
        <span class="oss-applicants__label">신청자</span>
        <%= safe_join(applicants.map { |participant|
              content_tag(:span, class: "oss-applicants__name oss-participant-popup-trigger", tabindex: "0") do
                safe_join([
                  participant.display_name,
                  open_session_participant_popup(participant)
                ])
              end
            }, ", ") %>
      </p>
    <% end %>

    <% if can_manage %>
      <div class="oss-card__admin">
        <%= link_to edit_game_session_path(session), class: "btn btn--secondary btn--sm" do %>
          <iconify-icon icon="lucide:pencil" width="12"></iconify-icon> 수정
        <% end %>
        <%= link_to game_session_path(session), class: "btn btn--ghost btn--sm" do %>
          <iconify-icon icon="lucide:external-link" width="12"></iconify-icon> 상세
        <% end %>
      </div>
    <% end %>
  </div>
</article>
