<style>
  .oss-admin-bar { display:flex; gap:8px; flex-wrap:wrap; margin:16px 0; }

  .oss-day { margin-top:20px; }
  .oss-day__title {
    display:flex; align-items:center; gap:6px;
    font-size:14px; font-weight:800; color:var(--hcp-black,#111);
    margin:0 0 10px; padding-bottom:6px;
    border-bottom:2px solid var(--hcp-border,#e5e7eb);
  }

  .oss-card {
    border:1px solid var(--hcp-border,#e5e7eb);
    border-radius:10px; background:#fff; margin-bottom:10px;
  }
  .oss-card__header {
    width:100%; display:flex; align-items:center; justify-content:space-between;
    gap:10px; padding:12px 14px; background:#fff; border:none; cursor:pointer; text-align:left;
    border-radius:10px 10px 0 0;
  }
  .oss-card__header:hover { background:#fafafa; }
  .oss-card__heading { display:flex; align-items:center; gap:8px; min-width:0; }
  .oss-card__court { font-size:15px; font-weight:800; color:var(--hcp-black,#111); }
  .oss-card__meta { display:flex; align-items:center; gap:8px; flex-shrink:0; }
  .oss-card__time { font-size:12px; color:var(--hcp-cool-gray,#6b7280); }
  .oss-card__count { font-size:13px; font-weight:700; color:var(--hcp-black,#111); }
  .oss-card__chevron { color:var(--hcp-cool-gray,#9ca3af); transition:transform 180ms ease; }
  .oss-card__header[aria-expanded="true"] .oss-card__chevron { transform:rotate(180deg); }

  .oss-status--open { background:#16a34a; border-color:#16a34a; color:#fff; }
  .oss-status--closed { opacity:0.7; }

  .oss-card__panel { padding:4px 14px 16px; border-top:1px solid var(--hcp-border,#f1f1f1); }
  .oss-card__title { font-size:14px; font-weight:700; margin:12px 0 8px; color:var(--hcp-charcoal,#333); }

  .oss-summary {
    display:flex; flex-wrap:wrap; gap:6px 16px;
    font-size:12px; color:var(--hcp-cool-gray,#6b7280); margin-bottom:12px;
  }
  .oss-summary strong { color:var(--hcp-black,#111); }

  .oss-slots {
    list-style:none; margin:0 0 12px; padding:0;
    display:grid; grid-template-columns:repeat(4, 1fr); gap:6px;
  }
  @media (min-width:520px) { .oss-slots { grid-template-columns:repeat(6, 1fr); } }
  .oss-slot {
    position:relative; display:flex; flex-direction:column; align-items:center; gap:3px;
    min-height:58px; padding:6px 4px; border-radius:8px;
    border:1px solid var(--hcp-border,#e5e7eb); background:#fafafa;
  }
  /* 오픈 게임: 정원 박스는 라임, 대기 박스는 라이트그레이 */
  .oss-slot--roster { background:#d9f99d; border-color:#bef264; }
  .oss-slot--wait { background:#f3f4f6; border-color:#d1d5db; border-style:dashed; }
  .oss-slot--mine { outline:2px solid #4f46e5; outline-offset:1px; }
  .oss-slot__no {
    position:absolute; top:3px; left:5px; font-size:10px; font-weight:700;
    color:var(--hcp-cool-gray,#9ca3af);
  }
  .oss-slot__filled { display:flex; flex-direction:column; align-items:center; gap:2px; margin-top:8px; color:#16a34a; }
  .oss-slot__name {
    font-size:11px; font-weight:600; color:var(--hcp-black,#111);
    max-width:56px; white-space:nowrap;
  }
  .oss-slot__name-text {
    display:block; max-width:56px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  }
  .oss-card--today { border-left: 3px solid #a3e635; }
  .oss-card__today-badge {
    display:inline-flex; align-items:center; justify-content:center;
    width:28px; height:28px; border-radius:50%;
    background:#a3e635; color:#1a1a1a; font-size:10px; font-weight:800;
    flex-shrink:0;
  }
  .oss-slot__form { margin:8px 0 0; }
  .oss-slot__recruit {
    display:inline-block; margin-top:8px; padding:4px 8px; border:none; border-radius:6px;
    background:#111; color:#fff; font-size:11px; font-weight:700; cursor:pointer;
    text-decoration:none; line-height:1.4;
  }
  .oss-slot__recruit:hover { background:#333; }
  .oss-slot__empty { margin-top:10px; color:#d4d4d8; }

  .oss-guide {
    display:flex; align-items:center; gap:4px; margin:0 0 10px;
    font-size:11px; color:var(--hcp-cool-gray,#6b7280); line-height:1.5;
  }
  .oss-applicants { font-size:12px; color:var(--hcp-charcoal,#444); margin:0 0 12px; }
  .oss-applicants__label {
    display:inline-block; margin-right:6px; padding:1px 7px; border-radius:10px;
    background:#f1f1f1; font-size:11px; font-weight:700; color:var(--hcp-cool-gray,#6b7280);
  }
  .oss-applicants__name { font-weight:600; color:var(--hcp-black,#111); }
  .oss-participant-popup-trigger {
    position:relative; display:inline-flex; align-items:center;
    cursor:pointer; border:none; background:transparent; padding:1px 0;
    text-decoration:underline; text-decoration-style:dotted; text-underline-offset:3px;
  }
  .oss-participant-popup-trigger:focus { outline:2px solid #a3e635; outline-offset:2px; border-radius:4px; }
  .oss-participant-popup {
    display:none; position:absolute; left:50%; bottom:calc(100% + 8px); transform:translateX(-50%);
    min-width:180px; padding:10px 12px; border-radius:8px;
    background:#111827; color:#fff; z-index:120;
    box-shadow:0 12px 28px rgba(15,23,42,.28);
  }
  .oss-participant-popup::after {
    content:""; position:absolute; top:100%; left:50%; transform:translateX(-50%);
    border:6px solid transparent; border-top-color:#111827;
  }
  .oss-participant-popup-trigger:hover .oss-participant-popup,
  .oss-participant-popup-trigger:focus .oss-participant-popup,
  .oss-participant-popup-trigger:focus-within .oss-participant-popup { display:flex; flex-direction:column; gap:6px; }
  .oss-participant-popup__name { font-size:12px; font-weight:800; padding-bottom:2px; border-bottom:1px solid rgba(255,255,255,.18); }
  .oss-participant-popup__row { display:flex; justify-content:space-between; gap:12px; font-size:11px; line-height:1.5; white-space:nowrap; }
  .oss-participant-popup__label { color:#cbd5e1; }

  .oss-card__admin { display:flex; gap:8px; padding-top:8px; border-top:1px dashed var(--hcp-border,#eee); }

  .oss-mine-bar {
    display:flex; align-items:center; justify-content:space-between; gap:8px;
    margin:0 0 12px; padding:8px 12px; border-radius:8px;
    background:#eef2ff; border:1px solid #c7d2fe;
  }
  .oss-mine-bar__label {
    display:flex; align-items:center; gap:5px;
    font-size:12px; font-weight:700; color:#4f46e5;
  }

  .oss-modal {
    width:min(420px, calc(100vw - 32px)); margin:auto;
    border:none; border-radius:12px; padding:0;
    box-shadow:0 24px 70px rgba(15,23,42,0.24);
  }
  .oss-modal::backdrop { background:rgba(15,23,42,0.42); }
  .oss-modal__header {
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 18px 12px; border-bottom:1px solid var(--hcp-border-light,#eee); background:#f8fafc;
  }
  .oss-modal__title { margin:0; font-size:16px; font-weight:800; color:var(--hcp-black,#111); }
  .oss-modal__close {
    width:30px; height:30px; border-radius:50%; border:1px solid var(--hcp-border-light,#e5e7eb);
    background:#fff; color:var(--hcp-mid-gray,#6b7280); cursor:pointer;
    display:inline-flex; align-items:center; justify-content:center;
  }
  .oss-modal__body { padding:16px 18px 18px; }
  .oss-modal__lead { font-size:13px; color:var(--hcp-charcoal,#333); margin:0 0 14px; line-height:1.6; }
  .oss-modal__info {
    margin:0 0 14px; padding:12px; border:1px solid var(--hcp-border,#e5e7eb);
    border-radius:8px; background:#fafafa; display:flex; flex-direction:column; gap:6px;
  }
  .oss-modal__info > div { display:flex; justify-content:space-between; font-size:13px; }
  .oss-modal__info dt { margin:0; color:var(--hcp-cool-gray,#6b7280); }
  .oss-modal__info dd { margin:0; font-weight:700; color:var(--hcp-black,#111); }
  .oss-modal__notice {
    display:flex; align-items:flex-start; gap:5px; margin:0 0 14px;
    font-size:12px; color:#92400e; background:#fffbeb; border:1px solid #fde68a;
    border-radius:8px; padding:9px 11px; line-height:1.5;
  }
  .oss-modal__footer { display:flex; justify-content:flex-end; gap:8px; margin-top:4px; }
</style>
