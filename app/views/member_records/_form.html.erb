<%= form_with model: member_record, class: "cl-form" do |f| %>
  <% if member_record.errors.any? %>
    <div class="cl-form__error">
      <% member_record.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>

  <div class="cl-form__field">
    <%= f.label :name, "이름", class: "cl-form__label" %>
    <%= f.text_field :name, class: "cl-form__input", required: true %>
  </div>

  <div class="cl-form__grid">
    <div class="cl-form__field">
      <%= f.label :club_name, "소속클럽", class: "cl-form__label" %>
      <%= f.select :club_name, [["선택 안 함", ""]] + MemberRecord::CLUBS, {}, class: "cl-form__input" %>
    </div>
    <div class="cl-form__field">
      <%= f.label :gender, "성별", class: "cl-form__label" %>
      <%= f.select :gender, [["선택 안 함", ""]] + MemberRecord::GENDERS, {}, class: "cl-form__input" %>
    </div>
  </div>

  <div class="cl-form__grid">
    <div class="cl-form__field">
      <%= f.label :birth_date, "생년월일", class: "cl-form__label" %>
      <%= f.date_field :birth_date, class: "cl-form__input" %>
    </div>
    <div class="cl-form__field">
      <%= f.label :phone, "연락처", class: "cl-form__label" %>
      <%= f.telephone_field :phone, class: "cl-form__input", placeholder: "010-0000-0000" %>
    </div>
  </div>

  <div class="cl-form__grid">
    <div class="cl-form__field">
      <%= f.label :pickleball_started_at, "피클볼 시작일", class: "cl-form__label" %>
      <%= f.month_field :pickleball_started_at, value: member_record.pickleball_started_at&.strftime("%Y-%m"), class: "cl-form__input" %>
    </div>
    <div class="cl-form__field">
      <%= f.label :club_joined_at, "클럽 가입시기", class: "cl-form__label" %>
      <%= f.month_field :club_joined_at, value: member_record.club_joined_at&.strftime("%Y-%m"), class: "cl-form__input" %>
    </div>
  </div>

  <div class="cl-form__field">
    <%= f.label :address, "주소", class: "cl-form__label" %>
    <%= f.text_field :address, class: "cl-form__input", placeholder: "우편물 받을 주소 또는 직장 주소" %>
  </div>

  <div class="cl-form__field" style="display:flex; gap:10px; padding:12px; background:var(--hcp-light-gray); border-radius:8px;">
    <%= f.check_box :privacy_agreed, style: "margin-top:3px; flex-shrink:0;" %>
    <div>
      <%= f.label :privacy_agreed, "개인정보 수집에 동의합니다.", class: "cl-form__label", style: "margin-bottom:4px;" %>
      <p style="font-size:11px; color:var(--hcp-cool-gray);">수집된 개인정보는 용인시피클볼협회의 회원관리 목적으로만 이용됩니다.</p>
    </div>
  </div>

  <%= f.submit member_record.new_record? ? "회원 등록" : "수정 완료", class: "cl-form__submit" %>
<% end %>
